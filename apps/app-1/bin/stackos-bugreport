#!/usr/bin/env python3

import gi
gi.require_version("Gtk", "4.0")

from gi.repository import Gtk, Gdk, GLib

import datetime
import getpass
import json
import os
import re
import subprocess
import threading
import urllib.parse
import webbrowser
from pathlib import Path
import sys

sys.path.insert(0, "/usr/lib/stackos")
from stackos_i18n import get_translator

_ = get_translator("stackos")


APP_ID = "com.stackos.bugreport"


GITHUB_ISSUES = (
    "https://github.com/stackoslinux-dev/bugs/issues/new"
)


DRIVERS_BIN = "/usr/local/bin/stackos-drivers"


CSS = b"""
