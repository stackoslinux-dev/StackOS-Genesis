    color: #3d78d8;
    font-size: 20px;
    font-weight: bold;
}

.label-white {
    color: #e0e8ff;
    font-size: 13px;
}

.label-blue {
    color: #8fb7ff;
    font-size: 12px;
}

.label-green {
    color: #78dba9;
    font-size: 12px;
}

.label-warn {
    color: #f2c96d;
    font-size: 12px;
}

.card {
    background-color: #0d1530;
    border-radius: 12px;
    border: 1px solid #1e2d5a;
}

.btn-primary {
    background-color: #3d78d8;
    color: white;
    border-radius: 6px;
    padding: 8px 20px;
    font-weight: bold;
    border: none;
}

.btn-secondary {
    background-color: #1a2040;
    color: #a0b4d8;
    border-radius: 6px;
    padding: 8px 20px;
