        shell = Gtk.Box(
            orientation=Gtk.Orientation.HORIZONTAL,
            spacing=0,
        )
        self.window.set_child(shell)

        # ── Sidebar ────────────────────────────────────────────────────
        sidebar = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL,
            spacing=14,
