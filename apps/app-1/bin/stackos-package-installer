#!/usr/bin/python3

import os
import subprocess
import sys
import threading
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
from gi.repository import Gtk, GLib, Gio

if "/usr/lib/stackos" not in sys.path:
    sys.path.insert(0, "/usr/lib/stackos")

from stackos_i18n import get_translator

_ = get_translator("stackos")


class PackageInstaller(Gtk.Application):
    def __init__(self):
        super().__init__(
            application_id="org.stackos.PackageInstaller",
            flags=Gio.ApplicationFlags.HANDLES_OPEN,
        )

        self.file_path = None
        self.file_type = None
        self.window = None

    def do_activate(self):
        if self.window is None:
            self.build_window()

        self.window.present()

    def do_open(self, files, n_files, hint):
        if self.window is None:
            self.build_window()

        if files:
            path = files[0].get_path()

            if path:
                self.load_file(Path(path))

        self.window.present()

    def build_window(self):
        self.window = Gtk.ApplicationWindow(application=self)
        self.window.set_title(_("StackOS Application Installer"))
        self.window.set_default_size(940, 640)
        self.window.set_resizable(False)

        # ── Tema StackOS ───────────────────────────────────────────────
        css = Gtk.CssProvider()
        css.load_from_data(b"""
        window {
            background: #070b14;
            color: #ffffff;
        }

        .sidebar {
            background: #0a111f;
            border-right: 1px solid rgba(61, 120, 216, 0.25);
            padding: 18px;
        }

        .brand {
            font-size: 24px;
            font-weight: 800;
        }

        .muted {
            color: #9aa7bd;
        }

        .nav-active {
            background: #155ed0;
            color: #ffffff;
            border-radius: 10px;
            padding: 10px 12px;
            font-weight: 700;
        }

        .page-title {
            font-size: 26px;
            font-weight: 800;
        }

        .card {
            background: #0d1524;
            border: 1px solid rgba(61, 120, 216, 0.30);
            border-radius: 14px;
            padding: 14px;
        }

        .info-card {
            background: rgba(16, 79, 175, 0.20);
            border: 1px solid rgba(61, 120, 216, 0.60);
