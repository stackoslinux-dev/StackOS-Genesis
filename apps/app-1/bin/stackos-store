def run(cmd):
    return subprocess.run(
        cmd,
        capture_output=True,
        text=True,
    )

def is_installed(pkg):
    r = run([
        "dpkg-query",
        "-W",
        "-f=${db:Status-Status}",
        pkg,
    ])

    return (
        r.returncode == 0
        and r.stdout.strip() == "installed"
    )

def get_version(pkg):
    r = run([
        "dpkg-query",
        "-W",
        "-f=${Version}",
        pkg,
    ])

    if r.returncode == 0:
        version = r.stdout.strip()
        return version or None

    return None

def check_updates_silent():
    """Atualiza os indices e retorna a lista de pacotes atualizaveis."""

    update = run([
        "pkexec",
        "/usr/bin/apt-get",
        "update",
        "-qq",
    ])

    if update.returncode != 0:
        return []

    r = run([
        "/usr/bin/apt",
        "list",
        "--upgradable",
    ])

    pkgs = []

    if r.returncode not in (0,):
        return pkgs

    for line in r.stdout.splitlines():
        line = line.strip()

        if not line or line.startswith("Listing"):
            continue

        if "/" not in line:
            continue

        parts = line.split()

        if not parts:
            continue

        name = parts[0].split("/", 1)[0]
        ver = parts[1] if len(parts) > 1 else ""

        if name:
            pkgs.append((name, ver))

    return pkgs

# ═══════════════════════════════════════════════════════════
class StackOSStore(Gtk.Application):
    def __init__(self):
        super().__init__(application_id='com.stackos.store')
        self.connect('activate', self.on_activate)
        self.current_category = 'Internet'
        self.votes = load_votes()
        self.updates_available = []   # lista de (pkg, ver)
        self.update_checked = False

    def on_activate(self, app):
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.win = Gtk.ApplicationWindow(application=app)
        self.win.set_title("StackOS Store")
        self.win.set_default_size(1000, 650)
        self.build_ui()
        self.win.present()
        # Verifica atualizações em segundo plano ao abrir
        pass  # sem verificacao

    # ── Layout ───────────────────────────────────────────────
    def build_ui(self):
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)

        # Header
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        header.add_css_class('header')
        header.set_margin_top(12); header.set_margin_bottom(12)
        header.set_margin_start(18); header.set_margin_end(18)

        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        title_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        t1 = Gtk.Label(label="Stack"); t1.add_css_class('store-title')
        t2 = Gtk.Label(label="OS"); t2.add_css_class('store-title-os')
        t3 = Gtk.Label(label=" Store"); t3.add_css_class('store-title')
        title_row.append(t1); title_row.append(t2); title_row.append(t3)
        title_box.append(title_row)
        sub = Gtk.Label(label="POWERED BY MOSA"); sub.add_css_class('store-sub')
        sub.set_halign(Gtk.Align.START); title_box.append(sub)
        header.append(title_box)

        spacer = Gtk.Box(); spacer.set_hexpand(True); header.append(spacer)

        search_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        search_icon = Gtk.Image.new_from_icon_name('system-search-symbolic')
        search_icon.set_pixel_size(14); search_icon.set_margin_end(6)
        self.search = Gtk.SearchEntry()
        self.search.add_css_class('search')
        self.search.set_placeholder_text(_("Search applications..."))
        self.search.connect('search-changed', self.on_search)
        search_box.append(search_icon); search_box.append(self.search)
        header.append(search_box)
        vbox.append(header)

        # Barra de categorias
        cat_scroll = Gtk.ScrolledWindow()
        cat_scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.NEVER)
        cat_scroll.set_margin_top(10); cat_scroll.set_margin_bottom(10)
        cat_scroll.set_margin_start(14); cat_scroll.set_margin_end(14)
        self.cat_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.cat_buttons = {}
        cats = list(APPS.keys())
        for cat in cats:
            btn = Gtk.Button(label=_(cat))
            btn.add_css_class('btn-category')
            btn.connect('clicked', self.on_category, cat)
            self.cat_buttons[cat] = btn
            self.cat_box.append(btn)
        cat_scroll.set_child(self.cat_box)
        vbox.append(cat_scroll)

        # Status + progress
        self.status_bar = Gtk.Label(label="")
        self.status_bar.add_css_class('label-blue')
        self.status_bar.set_halign(Gtk.Align.START)
        self.status_bar.set_margin_start(18); self.status_bar.set_margin_bottom(4)
        vbox.append(self.status_bar)
        self.progress = Gtk.ProgressBar()
        self.progress.add_css_class('progress')
        self.progress.set_margin_start(18); self.progress.set_margin_end(18)
        self.progress.set_margin_bottom(6); self.progress.set_visible(False)
        vbox.append(self.progress)

        # Stack: lista ↔ detalhe
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self.stack.set_transition_duration(180)
        self.stack.set_vexpand(True)

        self.list_scroll = Gtk.ScrolledWindow()
        self.list_scroll.set_vexpand(True)
        self.list_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.stack.add_named(self.list_scroll, 'list')

        self.detail_scroll = Gtk.ScrolledWindow()
        self.detail_scroll.set_vexpand(True)
        self.detail_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.stack.add_named(self.detail_scroll, 'detail')

        vbox.append(self.stack)
        self.win.set_child(vbox)
        self.show_category('Internet')

    # ── Verificação de atualizações (segundo plano) ────────────
    def _start_update_check(self):
        self._set_status(_("Checking for updates..."), 'blue')
        def do():
            pkgs = check_updates_silent()
            GLib.idle_add(self._on_updates_found, pkgs)
        threading.Thread(target=do, daemon=True).start()

    def _on_updates_found(self, pkgs):
        self.updates_available = pkgs
        self.update_checked = True
        if pkgs:
            n = len(pkgs)
            if n == 1:
                message = _(
                    "🔔 {count} update available! Click Updates."
                ).format(count=n)
            else:
                message = _(
                    "🔔 {count} updates available! Click Updates."
                ).format(count=n)

            self._set_status(message, 'orange')
            # Badge no botão
            if 'Atualizacoes' in self.cat_buttons:
                self.cat_buttons['Atualizacoes'].remove_css_class('btn-category')
                self.cat_buttons['Atualizacoes'].set_label(
                    f"🔔 " + _("Updates") + f" ({n})"
                )
                self.cat_buttons['Atualizacoes'].add_css_class('btn-update-badge')
        else:
            self._set_status("✓  " + _("System is up to date."), 'green')

    # ── Navegação ────────────────────────────────────────────
    def on_category(self, btn, cat):
        for c, b in self.cat_buttons.items():
            b.remove_css_class('btn-category-active')
            if c != 'Atualizacoes' or not self.updates_available:
                b.add_css_class('btn-category')
        self.cat_buttons[cat].remove_css_class('btn-category')
        self.cat_buttons[cat].remove_css_class('btn-update-badge')
        self.cat_buttons[cat].add_css_class('btn-category-active')
        self.stack.set_visible_child_name('list')
        self.show_category(cat)

    def on_search(self, entry):
        term = entry.get_text().strip().lower()
        if term: self.show_search(term)
        else:    self.show_category(self.current_category)

    def show_category(self, cat):
        self.current_category = cat
        self.stack.set_visible_child_name('list')
        if cat == 'Atualizacoes':  self.show_updates(); return
        self.show_apps(APPS.get(cat, []))

    def show_search(self, term):
        r = run([
            "/usr/bin/apt-cache",
            "search",
            term,
        ])
        apps = []
        for line in r.stdout.splitlines():
            if ' - ' in line:
                n, d = line.split(' - ', 1)
                apps.append((
                    n.strip(),
                    n.strip().title(),
                    d.strip()[:60],
                    'application-x-executable',
                    '',
                ))

                if len(apps) >= 30:
                    break
        self.stack.set_visible_child_name('list')
        self.show_apps(apps)

    # ── Grid de apps ─────────────────────────────────────────
    def show_apps(self, apps):
        flow = Gtk.FlowBox()
        flow.set_valign(Gtk.Align.START)
        flow.set_max_children_per_line(4); flow.set_min_children_per_line(2)
        flow.set_selection_mode(Gtk.SelectionMode.NONE)
        flow.set_row_spacing(10); flow.set_column_spacing(10)
        flow.set_margin_top(10); flow.set_margin_bottom(10)
        flow.set_margin_start(12); flow.set_margin_end(12)
        if not apps:
            lbl = Gtk.Label(label=_("No applications found."))
            lbl.add_css_class('label-gray'); lbl.set_margin_top(60)
            self.list_scroll.set_child(lbl); return
        for app_data in apps:
            flow.append(self.make_app_card(app_data))
        self.list_scroll.set_child(flow)

    def make_app_card(self, app_data):
        pkg  = app_data[0]; name = app_data[1]
        desc = app_data[2]; icon = app_data[3]
        card_btn = Gtk.Button()
        card_btn.add_css_class('app-card')
        card_btn.set_size_request(200, 165)
        card_btn.set_margin_top(4); card_btn.set_margin_bottom(4)
        card_btn.set_margin_start(4); card_btn.set_margin_end(4)
        card_btn.connect('clicked', lambda _, ad=app_data: self.open_detail(ad))
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        # Ícone
        icon_box = Gtk.Box(); icon_box.set_halign(Gtk.Align.CENTER)
        icon_box.set_margin_top(16)
        img = Gtk.Image()
        local  = f'/usr/share/stackos-store/icons/{icon}.svg'
        papirus = f'/usr/share/icons/Papirus/48x48/apps/{icon}.svg'
        hicolor = f'/usr/share/icons/hicolor/48x48/apps/{icon}.png'
        if __import__('os').path.exists(local):
            img.set_from_file(local)
            img.set_pixel_size(52)
        elif __import__('os').path.exists(papirus):
            img.set_from_file(papirus)
            img.set_pixel_size(52)
        elif __import__('os').path.exists(hicolor):
            img.set_from_file(hicolor)
            img.set_pixel_size(52)
        else:
            img.set_from_icon_name('application-x-executable'); img.set_pixel_size(52)
        icon_box.append(img); inner.append(icon_box)
        # Nome
        nl = Gtk.Label(label=_(name)); nl.add_css_class('app-name')
        nl.set_halign(Gtk.Align.CENTER); nl.set_ellipsize(3); inner.append(nl)
        # Desc
        translated_desc = _(desc)
        dl = Gtk.Label(
            label=translated_desc[:45]
            + ('...' if len(translated_desc) > 45 else '')
        )
        dl.add_css_class('app-desc'); dl.set_halign(Gtk.Align.CENTER)
        dl.set_justify(Gtk.Justification.CENTER); dl.set_wrap(True)
        dl.set_margin_start(8); dl.set_margin_end(8); inner.append(dl)
        # Badge instalado
        installed = is_installed(pkg)
        if installed:
            ib = Gtk.Label(label="✓ " + _("Installed")); ib.add_css_class('installed-badge')
            ib.set_halign(Gtk.Align.CENTER); inner.append(ib)
        # Votos
        v = self.votes.get(pkg, {'up':0,'down':0,'mine':None})
        vr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        vr.set_halign(Gtk.Align.CENTER); vr.set_margin_bottom(10)
        vr.append(self._lbl(f'👍 {v["up"]}', 'vote-count'))
        vr.append(self._lbl(f'👎 {v["down"]}', 'vote-count'))
        inner.append(vr)
        card_btn.set_child(inner)
        return card_btn

    def _lbl(self, txt, cls):
        l = Gtk.Label(label=txt); l.add_css_class(cls); return l

    # ── Tela de detalhe ───────────────────────────────────────
    def open_detail(self, app_data):
        pkg  = app_data[0]; name = app_data[1]
        desc = app_data[2]; icon = app_data[3]
        url  = app_data[4] if len(app_data) > 4 else ''
        installed = is_installed(pkg)
        version   = get_version(pkg)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        outer.set_margin_top(22); outer.set_margin_start(26)
        outer.set_margin_end(26); outer.set_margin_bottom(26)

        back = Gtk.Button(label="← " + _("Back"))
        back.add_css_class('det-back'); back.set_halign(Gtk.Align.START)
        back.set_margin_bottom(22)
        back.connect('clicked', lambda _: self.stack.set_visible_child_name('list'))
        outer.append(back)

        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=20)
        top.set_margin_bottom(20)
        img = Gtk.Image()
        local  = f'/usr/share/stackos-store/icons/{icon}.svg'
        papirus = f'/usr/share/icons/Papirus/48x48/apps/{icon}.svg'
        hicolor = f'/usr/share/icons/hicolor/48x48/apps/{icon}.png'
        if __import__('os').path.exists(local):
            img.set_from_file(local)
            img.set_pixel_size(82)
        elif __import__('os').path.exists(papirus):
            img.set_from_file(papirus)
            img.set_pixel_size(82)
        elif __import__('os').path.exists(hicolor):
            img.set_from_file(hicolor)
            img.set_pixel_size(82)
        else:
            img.set_from_icon_name('application-x-executable'); img.set_pixel_size(82)
        top.append(img)
        info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
        info.set_valign(Gtk.Align.CENTER)
        n = Gtk.Label(label=_(name)); n.add_css_class('det-name'); n.set_halign(Gtk.Align.START); info.append(n)
        p = Gtk.Label(label=_("Package: {package}").format(package=pkg)); p.add_css_class('det-pkg'); p.set_halign(Gtk.Align.START); info.append(p)
        if installed and version:
            vl = Gtk.Label(label=_("Installed version: {version}").format(version=version))
            vl.add_css_class('det-ver'); vl.set_halign(Gtk.Align.START); info.append(vl)
        top.append(info); outer.append(top)

        sep = Gtk.Separator(); sep.add_css_class('det-sep'); sep.set_margin_bottom(16); outer.append(sep)

        dt = Gtk.Label(label=_("Description")); dt.add_css_class('det-desc-t')
        dt.set_halign(Gtk.Align.START); dt.set_margin_bottom(8); outer.append(dt)
        dtxt = Gtk.Label(label=_(desc)); dtxt.add_css_class('det-desc')
        dtxt.set_halign(Gtk.Align.START); dtxt.set_wrap(True)
        dtxt.set_xalign(0); dtxt.set_margin_bottom(22); outer.append(dtxt)

        ar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        ar.set_margin_bottom(24)
        self.action_btn = Gtk.Button(label=_("Remove") if installed else _("Install"))
        self.action_btn.add_css_class('btn-remove' if installed else 'btn-install')
        self.action_btn.connect('clicked', lambda _, p=pkg, i=installed: self.do_action(p, i))
        ar.append(self.action_btn)
        if url:
            sb = Gtk.Button()
            sr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            si = Gtk.Image.new_from_icon_name('web-browser-symbolic'); si.set_pixel_size(13); sr.append(si)
            sr.append(Gtk.Label(label=_("Official website")))
            sb.set_child(sr); sb.add_css_class('btn-site')
            sb.connect('clicked', lambda _, u=url: subprocess.Popen(['xdg-open', u]))
            ar.append(sb)
        outer.append(ar)

        sep2 = Gtk.Separator(); sep2.add_css_class('det-sep'); sep2.set_margin_bottom(16); outer.append(sep2)

        # Votação
        vd = self.votes.get(pkg, {'up':0,'down':0,'mine':None})
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        vbox.add_css_class('vote-box'); vbox.set_halign(Gtk.Align.START)
        vt = Gtk.Label(label=_("RATE THIS APP")); vt.add_css_class('vote-lbl')
        vt.set_halign(Gtk.Align.START); vbox.append(vt)
        vbtns = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        self.like_btn    = Gtk.Button(label=f"👍  {vd['up']}")
        self.dislike_btn = Gtk.Button(label=f"👎  {vd['down']}")
        self.like_btn.add_css_class('btn-like-on' if vd['mine']=='up' else 'btn-like')
        self.dislike_btn.add_css_class('btn-dis-on' if vd['mine']=='down' else 'btn-dis')
        self.like_btn.connect('clicked',    lambda _, p=pkg: self.do_vote(p,'up'))
        self.dislike_btn.connect('clicked', lambda _, p=pkg: self.do_vote(p,'down'))
        vbtns.append(self.like_btn); vbtns.append(self.dislike_btn); vbox.append(vbtns)
        hint = Gtk.Label(label=_("Your rating helps other users."))
        hint.add_css_class('vote-hint'); hint.set_halign(Gtk.Align.START); vbox.append(hint)
        outer.append(vbox)

        self.detail_scroll.set_child(outer)
        self.stack.set_visible_child_name('detail')

    # ── Tela de Atualizações ──────────────────────────────────
    def show_updates(self):
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        outer.set_margin_top(16); outer.set_margin_start(16)
        outer.set_margin_end(16); outer.set_margin_bottom(16)
        banner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        banner.add_css_class('update-banner'); banner.set_margin_bottom(20)
        brow = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        bic = Gtk.Image.new_from_icon_name('software-update-available-symbolic')
        bic.set_pixel_size(36); brow.append(bic)
        btxt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        if self.updates_available:
            n = len(self.updates_available)
            if n == 1:
                text = _(
                    "🔔 {count} update available!"
                ).format(count=n)
            else:
                text = _(
                    "🔔 {count} updates available!"
                ).format(count=n)

            bt = Gtk.Label(label=text)
        elif self.update_checked:
            bt = Gtk.Label(label="✓  " + _("System is fully up to date!"))
        else:
            bt = Gtk.Label(label="⟳  " + _("Checking for updates..."))
        bt.add_css_class('update-title'); bt.set_halign(Gtk.Align.START); btxt.append(bt)
        bs = Gtk.Label(label=_("Updates can be installed with administrative authentication."))
        bs.add_css_class('update-sub'); bs.set_halign(Gtk.Align.START); btxt.append(bs)
        brow.append(btxt); banner.append(brow)
        ref_btn = Gtk.Button(label="↻  " + _("Check again"))
        ref_btn.add_css_class('btn-site'); ref_btn.set_halign(Gtk.Align.START)
        ref_btn.connect('clicked', lambda _: self._recheck())
        banner.append(ref_btn)
        outer.append(banner)
        if self.updates_available:
            for pkg, ver in self.updates_available:
                row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
                row.add_css_class('update-item')
                ic = Gtk.Image.new_from_icon_name('package-x-generic-symbolic')
                ic.set_pixel_size(20); row.append(ic)
                info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                info.set_hexpand(True)
                pl = Gtk.Label(label=pkg); pl.add_css_class('update-pkg'); pl.set_halign(Gtk.Align.START); info.append(pl)
                vl = Gtk.Label(label=ver);  vl.add_css_class('update-ver');  vl.set_halign(Gtk.Align.START); info.append(vl)
                row.append(info); outer.append(row)
        elif self.update_checked:
            ok = Gtk.Label(label="✓  " + _("No pending updates."))
            ok.add_css_class('no-updates'); ok.set_halign(Gtk.Align.CENTER)
            ok.set_margin_top(40); outer.append(ok)
        self.list_scroll.set_child(outer)

    def do_upgrade(self):
        self.progress.set_visible(True)
        self.progress.set_fraction(0.0)
        self._set_status(_("Preparing update..."), 'orange')
        total = len(self.updates_available) or 1
        done = [0]
        def do():
            import subprocess as sp
            proc = sp.Popen(
                ["pkexec", "/usr/bin/apt-get", "upgrade", "-y"],
                stdout=sp.PIPE, stderr=sp.STDOUT, text=True
            )
            for line in proc.stdout:
                line = line.strip()
                if line.startswith(('Desempacotando', 'Configurando', 'Unpacking', 'Setting up')):
                    done[0] += 1
                    frac = min(done[0] / total, 1.0)
                    pkg_name = line.split()[1] if len(line.split()) > 1 else ''
                    GLib.idle_add(self.progress.set_fraction, frac)
                    GLib.idle_add(
                        self._set_status,
                        _("Installing: {package}").format(package=pkg_name),
                        'orange'
                    )
            proc.wait()
            ok = proc.returncode == 0
            def on_done():
                self.progress.set_fraction(1.0 if ok else 0.0)
                self.progress.set_visible(False)
                self._set_status(
                    (
                        "✓ " + _("System updated!")
                        if ok
                        else "✗ " + _("Update failed.")
                    ),
                    'green' if ok else 'red')
                if ok:
                    self.updates_available = []
                    if 'Atualizacoes' in self.cat_buttons:
                        self.cat_buttons['Atualizacoes'].remove_css_class('btn-update-badge')
                        self.cat_buttons['Atualizacoes'].add_css_class('btn-category')
                        self.cat_buttons['Atualizacoes'].set_label(_('Updates'))
                    self.show_updates()
            GLib.idle_add(on_done)
        threading.Thread(target=do, daemon=True).start()

    def _recheck(self):
        self.updates_available = []
        self.update_checked = False
        self.show_updates()

        def do():
            updates = check_updates_silent()

            def done():
                self.updates_available = updates
                self.update_checked = True
                self.show_updates()

                if 'Atualizacoes' in self.cat_buttons:
                    button = self.cat_buttons['Atualizacoes']

                    if updates:
                        button.remove_css_class('btn-category')
                        button.add_css_class('btn-update-badge')
                        button.set_label(
                            f"🔔 " + _("Updates") + f" ({len(updates)})"
                        )
                    else:
                        button.remove_css_class('btn-update-badge')
                        button.add_css_class('btn-category')
                        button.set_label(_("Updates"))

                return False

            GLib.idle_add(done)

        threading.Thread(
            target=do,
            daemon=True,
        ).start()

    # ── Instalar / Remover ────────────────────────────────────
    def do_action(self, pkg, installed):
        self.action_btn.set_sensitive(False); self.action_btn.set_label(_("Please wait…"))
        action = 'remove' if installed else 'install'
        self._set_status(
            (
                _("Removing {package}...")
                if installed
                else _("Installing {package}...")
            ).format(package=pkg),
            'blue'
        )
        self.progress.set_visible(True)
        def do():
            GLib.idle_add(self.progress.pulse)
            r = run([
                "pkexec",
                "/usr/bin/apt-get",
                action,
                "-y",
                pkg,
            ])
            ok = r.returncode == 0
            GLib.idle_add(self._set_status,
                (
                    "✓ " + (
                        _("{package} removed.")
                        if installed
                        else _("{package} installed.")
                    ).format(package=pkg)
                    if ok
                    else "✗ " + _("Failed: {package}.").format(package=pkg)
                ),
                'green' if ok else 'red')
            GLib.idle_add(self.progress.set_visible, False)
            GLib.idle_add(self.show_category, self.current_category)
        threading.Thread(target=do, daemon=True).start()

    # ── Votação ───────────────────────────────────────────────
    def do_vote(self, pkg, vt):
        v = self.votes.get(pkg, {'up':0,'down':0,'mine':None})
        if v['mine'] == vt:
            v[vt] = max(0, v[vt]-1); v['mine'] = None
        else:
            if v['mine']: v[v['mine']] = max(0, v[v['mine']]-1)
            v[vt] += 1; v['mine'] = vt
        self.votes[pkg] = v; save_votes(self.votes)
        self.like_btn.set_label(f"👍  {v['up']}")
        self.dislike_btn.set_label(f"👎  {v['down']}")
        for c in ('btn-like','btn-like-on'): self.like_btn.remove_css_class(c)
        for c in ('btn-dis','btn-dis-on'):   self.dislike_btn.remove_css_class(c)
        self.like_btn.add_css_class('btn-like-on' if v['mine']=='up' else 'btn-like')
        self.dislike_btn.add_css_class('btn-dis-on' if v['mine']=='down' else 'btn-dis')

    def _set_status(self, text, kind='blue'):
        self.status_bar.set_text(text)
        for c in ('label-blue','label-green','label-orange','label-red','label-gray'):
            self.status_bar.remove_css_class(c)
        self.status_bar.add_css_class(f'label-{kind}')


app = StackOSStore()
app.run([])
