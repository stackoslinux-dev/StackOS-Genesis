#!/usr/bin/env python3
import gi
gi.require_version('Gtk', '4.0')
from gi.repository import Gtk, Gdk, GLib, GdkPixbuf
import subprocess, os, threading, datetime, shutil, json
import sys

if "/usr/lib/stackos" not in sys.path:
    sys.path.insert(0, "/usr/lib/stackos")

from stackos_i18n import get_translator

_ = get_translator("stackos")

VOTES_FILE = os.path.expanduser('~/.config/stackos-store/votes.json')

def load_votes():
    try:
        if os.path.exists(VOTES_FILE):
            with open(VOTES_FILE) as f:
                return json.load(f)
    except: pass
    return {}

def save_votes(votes):
    try:
        os.makedirs(os.path.dirname(VOTES_FILE), exist_ok=True)
        with open(VOTES_FILE, 'w') as f:
            json.dump(votes, f, indent=2)
    except: pass

