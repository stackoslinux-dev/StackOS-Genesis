#!/usr/bin/env python3

import json
import os
from pathlib import Path
import subprocess
import time
from datetime import datetime


CONFIG_DIR = Path.home() / ".config/stackos"
CONFIG_FILE = CONFIG_DIR / "updater.json"

CACHE_DIR = Path.home() / ".cache/stackos-updater"
STATUS_FILE = CACHE_DIR / "status.json"

DEFAULT_CONFIG = {
    "mode": "manual",
    "check_interval_hours": 6,
    "check_on_startup": True,
    "auto_install_normal": True,
    "auto_install_critical": True,
    "notify": True,
}


def ensure_files():
    CONFIG_DIR.mkdir(
        parents=True,
        exist_ok=True,
    )

    CACHE_DIR.mkdir(
        parents=True,
        exist_ok=True,
    )

    if not CONFIG_FILE.exists():
        CONFIG_FILE.write_text(
            json.dumps(
                DEFAULT_CONFIG,
                indent=2,
                ensure_ascii=False,
            )
            + "\n",
            encoding="utf-8",
        )


def load_config():
    ensure_files()

    try:
        data = json.loads(
            CONFIG_FILE.read_text(
                encoding="utf-8"
            )
        )
    except Exception:
        data = {}

    config = DEFAULT_CONFIG.copy()
    config.update(data)

    try:
        interval = int(
            config["check_interval_hours"]
        )
    except Exception:
        interval = 6

    config["check_interval_hours"] = max(
        1,
        min(interval, 168),
    )

    return config


def write_status(data):
    CACHE_DIR.mkdir(
        parents=True,
        exist_ok=True,
    )

    temporary = STATUS_FILE.with_suffix(
        ".json.tmp"
    )

    temporary.write_text(
        json.dumps(
            data,
            indent=2,
            ensure_ascii=False,
        )
        + "\n",
        encoding="utf-8",
    )

    temporary.replace(STATUS_FILE)


def notify(title, message):
    subprocess.run(
        [
            "notify-send",
            "--app-name=StackOS Updater",
            title,
            message,
        ],
        check=False,
    )


def call_helper(action):
    result = subprocess.run(
        [
            "sudo",
            "-n",
            "/usr/lib/stackos/"
            "stackos-updater-helper",
            action,
        ],
        capture_output=True,
        text=True,
    )

    if result.returncode != 0:
        raise RuntimeError(
            result.stderr.strip()
            or result.stdout.strip()
            or "Falha no helper."
        )

    if action == "install":
        for line in reversed(
            result.stdout.splitlines()
        ):
            if line.startswith(
                "__STACKOS_RESULT__"
            ):
                return json.loads(
                    line.replace(
                        "__STACKOS_RESULT__",
                        "",
                        1,
                    )
                )

        raise RuntimeError(
            "Resultado final não recebido."
        )

    return json.loads(result.stdout)


def check_cycle():
    config = load_config()

    try:
        data = call_helper("check")
        data["service_error"] = ""
        write_status(data)

        count = data.get("count", 0)
        critical = data.get(
            "critical_count",
            0,
        )

        if (
            config["mode"] == "automatic"
            and count > 0
        ):
            allow_normal = bool(
                config.get(
                    "auto_install_normal",
                    True,
                )
            )
            allow_critical = bool(
                config.get(
                    "auto_install_critical",
                    True,
                )
            )

            should_install = (
                critical > 0 and allow_critical
            ) or (
                count > critical
                and allow_normal
            )

            if should_install:
                data = call_helper("install")
                data["service_error"] = ""
                write_status(data)

                if config.get("notify", True):
                    notify(
                        "StackOS atualizado",
                        "As atualizações automáticas "
                        "foram instaladas.",
                    )

        elif count > 0 and config.get(
            "notify",
            True,
        ):
            if critical:
                notify(
                    "Atualização necessária",
                    f"{critical} atualização(ões) "
                    "crítica(s) disponível(is).",
                )
            else:
                notify(
                    "Atualizações disponíveis",
                    f"{count} pacote(s) "
                    "aguardando atualização.",
                )

    except Exception as error:
        write_status({
            "status": "red",
            "count": 0,
            "critical_count": 0,
            "packages": [],
            "blocked": [],
            "blocked_count": 0,
            "reboot_required": False,
            "checked_at": datetime.now().isoformat(
                timespec="seconds"
            ),
            "service_error": str(error),
        })


def main():
    ensure_files()

    first_run = True

    while True:
        config = load_config()

        if (
            not first_run
            or config.get(
                "check_on_startup",
                True,
            )
        ):
            check_cycle()

        first_run = False

        seconds = (
            config["check_interval_hours"]
            * 3600
        )

        time.sleep(seconds)


if __name__ == "__main__":
    main()
