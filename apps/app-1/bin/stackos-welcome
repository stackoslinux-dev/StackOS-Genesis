#!/usr/bin/env python3
import gi
gi.require_version('Gtk', '4.0')
from gi.repository import Gtk, Gdk, GLib
import subprocess
import sys
sys.path.insert(0, '/usr/lib/stackos')
from stackos_i18n import get_translator
_ = get_translator("stackos")

CSS = b"""
window { background-color: #05081c; }
.title { color: #3d78d8; font-size: 28px; font-weight: bold; }
.subtitle { color: #7b2ff7; font-size: 14px; }
.desc { color: #a0b4d8; font-size: 13px; }
.card { background-color: #0d1530; border-radius: 12px; padding: 20px; border: 1px solid #1e2d5a; }
.btn-primary { background-color: #3d78d8; color: white; border-radius: 8px; padding: 10px 20px; font-weight: bold; border: none; }
.btn-primary:hover { background-color: #5590e8; }
.btn-secondary { background-color: #1a2040; color: #a0b4d8; border-radius: 8px; padding: 10px 20px; border: 1px solid #3d78d8; }
.btn-secondary:hover { background-color: #232d50; }
.label-white { color: #e0e8ff; font-size: 14px; }
.label-blue { color: #3d78d8; font-size: 13px; }
"""

class StackOSWelcome(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="com.stackos.welcome")
        self.connect("activate", self.on_activate)

    def on_activate(self, app):
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )
        win = Gtk.ApplicationWindow(application=app)
        win.set_title(_("Bem-vindo ao StackOS Genesis"))
        win.set_default_size(700, 520)
        win.set_resizable(False)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        box.set_margin_top(40)
        box.set_margin_bottom(40)
        box.set_margin_start(60)
        box.set_margin_end(60)

        # Header
        logo = Gtk.Label(label="⚡ StackOS Genesis")
        logo.add_css_class("title")
        logo.set_margin_bottom(6)
        box.append(logo)

        sub = Gtk.Label(label=_("Modular. Leve. Poderoso."))
        sub.add_css_class("subtitle")
        sub.set_margin_bottom(30)
        box.append(sub)

        # Card info
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        card.add_css_class("card")
        card.set_margin_bottom(20)

        msg = Gtk.Label(label="Bem-vindo ao StackOS Genesis 1.1!\n\nSeu sistema Linux modular, leve e poderoso.\nUse a loja para instalar aplicativos e o gerenciador\nde drivers para configurar seu hardware.")
        msg.add_css_class("label-white")
        msg.set_justify(Gtk.Justification.CENTER)
        msg.set_wrap(True)
        card.append(msg)
        box.append(card)

        # Botoes
        grid = Gtk.Grid()
        grid.set_column_spacing(12)
        grid.set_row_spacing(12)
        grid.set_margin_bottom(20)

        btns = [
            (_("📦 Loja de Apps"), "stackos-store", 0, 0),
            (_("🔧 Drivers"), "stackos-drivers", 1, 0),
            (_("🌐 Site Oficial"), "xdg-open https://stackoslinux-dev.github.io", 0, 1),
            (_("📖 Documentacao"), "xdg-open https://stackoslinux-dev.github.io/docs", 1, 1),
            (_("💬 Forum"), "xdg-open https://github.com/stackoslinux-dev/repo/discussions", 0, 2),
            (_("📧 Contato"), "xdg-open mailto:stackoslinux@gmail.com", 1, 2),
        ]

        for label, cmd, col, row in btns:
            btn = Gtk.Button(label=label)
            btn.add_css_class("btn-secondary")
            btn.set_hexpand(True)
            btn.connect("clicked", lambda b, c=cmd: subprocess.Popen(c.split()))
            grid.attach(btn, col, row, 1, 1)

        box.append(grid)

        # Fechar
        btn_close = Gtk.Button(label=_("Comecar a usar o StackOS →"))
        btn_close.add_css_class("btn-primary")
        btn_close.set_halign(Gtk.Align.CENTER)
        btn_close.connect("clicked", lambda b: app.quit())
        box.append(btn_close)

        win.set_child(box)
        win.present()

app = StackOSWelcome()
app.run()
