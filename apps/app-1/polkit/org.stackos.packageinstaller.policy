<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">

<policyconfig>

  <vendor>StackOS</vendor>
  <vendor_url>https://stackoslinux-dev.github.io</vendor_url>

  <action id="org.stackos.packageinstaller.install">

    <description>Instalar pacotes no StackOS</description>

    <message>
      Autenticação necessária para instalar este pacote.
    </message>

    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>

    <annotate key="org.freedesktop.policykit.exec.path">
      /usr/lib/stackos/stackos-package-installer-helper
    </annotate>

    <annotate key="org.freedesktop.policykit.exec.allow_gui">
      true
    </annotate>

  </action>

</policyconfig>
