#!/bin/sh
set -e
if [ "$1" = configure ]; then
 systemctl --global enable stackos-gpu-indicator.service >/dev/null 2>&1 || true
 update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
 gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
 for runtime in /run/user/[0-9]*; do
  [ -d "$runtime" ] || continue
  uid=$(basename "$runtime")
  [ "$uid" -gt 0 ] || continue
  name=$(getent passwd "$uid" | cut -d: -f1)
  [ -n "$name" ] || continue
  runuser -u "$name" -- env XDG_RUNTIME_DIR="$runtime" DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" XDG_CURRENT_DESKTOP=GNOME /usr/bin/stackos-gpu-session >/dev/null 2>&1 &
 done
fi
exit 0
