class CommandError(RuntimeError):
    pass

def run(cmd, check=True):
    result = subprocess.run(cmd, shell=isinstance(cmd, str), capture_output=True, text=True)
    if check and result.returncode != 0:
        raise CommandError(f"Falha no comando (código {result.returncode}): {cmd}\n{result.stderr[-3000:]}")
    return result


def _slug(s):
    # transforma texto livre em pedaco valido de hostname:
    # minusculas, so [a-z0-9-], sem repetir/iniciar/terminar com '-'
    s = (s or "").strip().lower()
    s = re.sub(r'[^a-z0-9]+', '-', s)
    s = re.sub(r'-+', '-', s).strip('-')
    return s

def hardware_tag():
    # le marca + modelo do hardware via DMI; devolve algo tipo "gigabyte-b450m"
    # se nao achar (VM/hardware generico), devolve "pc"
    def read(path):
        try:
            with open(path) as f:
                return f.read().strip()
        except Exception:
            return ""
    base = "/sys/class/dmi/id/"
    vendor = read(base + "board_vendor") or read(base + "sys_vendor")
    model  = read(base + "board_name")   or read(base + "product_name")
    # palavras inuteis comuns que aparecem no DMI
    lixo = {"to", "be", "filled", "by", "oem", "o", "e", "m", "default", "string",
            "system", "manufacturer", "product", "name", "version", "none", "na",
            "inc", "ltd", "co", "corporation", "computer", "technology", "tech",
            "international", "group"}
    def limpa(txt, max_tokens=2):
        toks = [t for t in _slug(txt).split('-') if t and t not in lixo]
        return "-".join(toks[:max_tokens])
    vendor = limpa(vendor, 1)   # so a marca: "gigabyte", "asustek", "dell"
    model  = limpa(model, 1)    # so o 1o pedaco do modelo: "b450m", "prime"
    tag = "-".join([p for p in (vendor, model) if p])
    return tag or "pc"

def hardware_label():
    # versao "bonita" pra mostrar na tela: ex "Asus PRIME B550M-A"
    # se nao achar, devolve "" (a tela mostra 'Nao detectado')
    def read(path):
        try:
            with open(path) as f:
                return f.read().strip()
        except Exception:
            return ""
    base = "/sys/class/dmi/id/"
    vendor = read(base + "board_vendor") or read(base + "sys_vendor")
    model  = read(base + "board_name")   or read(base + "product_name")
    ruins = {"to be filled by o.e.m.", "default string", "system product name",
             "system manufacturer", "to be filled by oem", "none", "n/a", ""}
    if vendor.strip().lower() in ruins: vendor = ""
    if model.strip().lower()  in ruins: model  = ""
    partes = [p for p in (vendor.strip(), model.strip()) if p]
    return " ".join(partes)

class StackOSInstaller(Gtk.Application):
    def __init__(self):
        super().__init__(application_id='com.stackos.installer')
        self.connect('activate', self.on_activate)
        self.preview = '--preview' in sys.argv
        self.installing = False
        self.install_failed = False
        self.disk = ""
        self.mode = ""
        self.username = ""
        self.password = ""
        self.hostname = ""
        self.locale = "pt_BR.UTF-8"
        self.timezone = "America/Sao_Paulo"
        self.keyboard_layout = "br"
        self.keyboard_variant = "abnt2"
        self.efi = ""
        self.root = ""
        self.recovery = ""
        self.backups = ""

    def on_activate(self, app):
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )
        self.win = Gtk.ApplicationWindow(application=app)
        self.win.set_title("Instalador StackOS")
        display = Gdk.Display.get_default()
        monitors = display.get_monitors()
        geometry = monitors.get_item(0).get_geometry() if monitors.get_n_items() else None
        self.win.set_default_size(min(940, geometry.width - 64) if geometry else 940,
                                  min(720, geometry.height - 96) if geometry else 680)
        self.win.set_resizable(True)
        header = Gtk.HeaderBar()
        header.set_show_title_buttons(True)
        header.set_decoration_layout(":minimize,maximize,close")
        brand = Gtk.Label(label="StackOS · Genesis")
        brand.add_css_class('heading')
        header.set_title_widget(brand)
        self.win.set_titlebar(header)
        self.shell = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.step_strip = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.step_strip.add_css_class('step-strip')
        self.step_label = Gtk.Label(xalign=0)
        self.step_label.add_css_class('step-label')
        self.step_label.set_ellipsize(Pango.EllipsizeMode.END)
        self.step_progress = Gtk.ProgressBar()
        self.step_progress.add_css_class('progress')
        self.step_strip.append(self.step_label)
        self.step_strip.append(self.step_progress)
        self.shell.append(self.step_strip)
        self.page_scroll = Gtk.ScrolledWindow(hexpand=True, vexpand=True)
        self.page_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.shell.append(self.page_scroll)
        self.navigation = Gtk.Box()
        self.shell.append(self.navigation)
        self.win.set_child(self.shell)
        self.responsive_boxes = []
        self.last_width = -1
        self.win.add_tick_callback(self.adapt_layout)
        self.win.connect('close-request', self.on_close)

        # Idioma inicial da interface.
        self.ui_lang = "pt_BR"

        self.show_welcome()
        self.win.present()

    def on_close(self, win):
        if self.installing:
            dialog = Gtk.AlertDialog(message="Instalação em andamento", detail="Aguarde o término para fechar o instalador.")
            dialog.show(self.win)
            return True
        dialog = Gtk.AlertDialog()
        dialog.set_message(self.tr("cancel_install"))
        dialog.set_detail(self.tr("cancel_detail"))
        dialog.set_buttons([
            self.tr("continue"),
            self.tr("exit")
        ])
        dialog.set_default_button(0)
        dialog.set_cancel_button(0)
        dialog.choose(self.win, None, self.on_close_response)
        return True

    def on_close_response(self, dialog, result):
        btn = dialog.choose_finish(result)
        if btn == 1:
            self.quit()

    def clear(self):
        self.page_scroll.set_child(None)
        self.page_scroll.get_vadjustment().set_value(0)
        while self.navigation.get_first_child():
            self.navigation.remove(self.navigation.get_first_child())
        self.responsive_boxes = []

    def adapt_layout(self, widget, clock):
        width = self.win.get_width()
        if width != self.last_width:
            self.last_width = width
            for box, threshold in self.responsive_boxes:
                box.set_orientation(Gtk.Orientation.VERTICAL if width < threshold else Gtk.Orientation.HORIZONTAL)
        return True

    def present_page(self, box, page):
        stages = {
            'welcome': (0, self.tr('start')),
            'disk': (1, self.tr('select_disk')),
            'mode': (1, self.tr('select_disk')),
            'confirm_erase': (1, self.tr('confirmation')),
            'dual_size': (1, self.tr('select_disk')),
            'locale': (2, self.tr('locale_title')),
            'user': (2, self.tr('configure_user')),
            'installing': (3, self.tr('installing_title')),
            'done': (4, self.tr('done_title')),
        }
        index, title = stages.get(page, (0, 'StackOS'))
        self.step_label.set_text(f"{index + 1} / 5  ·  {title}")
        self.step_progress.set_fraction((index + 1) / 5)
        box.set_margin_start(24)
        box.set_margin_end(24)
        box.set_margin_top(24)
        box.set_margin_bottom(24)
        last = box.get_last_child()
        if last and last.has_css_class('page-nav'):
            box.remove(last)
            last.set_margin_top(0)
            last.set_halign(Gtk.Align.FILL)
            last.set_hexpand(True)
            self.navigation.append(last)
            self.navigation.add_css_class('navigation')
            self.navigation.set_visible(True)
        else:
            self.navigation.set_visible(False)
        def wrap_labels(widget):
            if isinstance(widget, Gtk.Label) and not widget.has_css_class("no-wrap"):
                widget.set_wrap(True)
                widget.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
            child = widget.get_first_child()
            while child:
                wrap_labels(child)
                child = child.get_next_sibling()
        wrap_labels(box)
        self.page_scroll.set_child(box)
        self.page_scroll.get_vadjustment().set_value(0)
        self.last_width = -1

    def make_header(self, subtitle=""):
        box = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL,
            spacing=4
        )
        box.set_margin_bottom(20)

        if subtitle:
            title = Gtk.Label(label=subtitle)
            title.add_css_class('title')
            title.set_halign(Gtk.Align.CENTER)
            box.append(title)

        sep = Gtk.Separator()
        sep.add_css_class('separator')
        sep.set_margin_top(10)
        box.append(sep)

        return box

    def make_nav(self, back_cb=None, next_label=None, next_cb=None, next_style='btn-primary'):
        if next_label is None:
            next_label = self.tr("next")

        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        box.add_css_class("page-nav")
        box.set_margin_top(20)
        box.set_halign(Gtk.Align.END)
        if back_cb:
            btn_back = Gtk.Button(
                label=self.tr("back")
            )
            btn_back.add_css_class('btn-secondary')
            btn_back.connect('clicked', back_cb)
            box.append(btn_back)
        btn_next = Gtk.Button(label=next_label)
        btn_next.add_css_class(next_style)
        if next_cb:
            btn_next.connect('clicked', next_cb)
        spacer = Gtk.Box(hexpand=True)
        box.append(spacer)
        box.append(btn_next)
        return box, btn_next

    UI_LANGUAGES = [
        ("Português (Brasil)",       "pt_BR"),
        ("Português (Portugal)",     "pt_PT"),
        ("English (United States)",  "en_US"),
