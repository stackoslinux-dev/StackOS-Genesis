    def get_world_map_handle(self):
        if hasattr(self, "_world_map_handle"):
            return self._world_map_handle

        path = "/usr/share/stackos-installer/world-map.svg"
        if self.preview:
            path = str(Path(__file__).resolve().parents[2] / "share/stackos-installer/world-map.svg")

        try:
            handle = Rsvg.Handle.new_from_file(path)

            # Visual StackOS aplicado ao mapa vetorial.
            try:
                handle.set_stylesheet(b"""
                    path {
                        fill: #0b2b59 !important;
                        fill-opacity: 1.0 !important;

                        stroke: #1682ff !important;
                        stroke-width: 0.28 !important;
                        stroke-opacity: 0.72 !important;

                        stroke-linejoin: round !important;
                        stroke-linecap: round !important;
                    }

                    text {
                        display: none !important;
                    }
                """)
            except Exception as e:
                print("Aviso CSS mapa:", e)

            self._world_map_handle = handle
            return handle

        except Exception as e:
            print("ERRO AO CARREGAR MAPA STACKOS:", e)
            self._world_map_handle = None
            return None


    def get_world_map_glow_handle(self):
        if hasattr(self, "_world_map_glow_handle"):
            return self._world_map_glow_handle

        path = "/usr/share/stackos-installer/world-map.svg"
        if self.preview:
            path = str(Path(__file__).resolve().parents[2] / "share/stackos-installer/world-map.svg")

        try:
            handle = Rsvg.Handle.new_from_file(path)

            try:
                handle.set_stylesheet(b"""
                    path {
                        fill: #1261bd !important;
                        fill-opacity: 0.72 !important;

                        stroke: #1787ff !important;
                        stroke-width: 0.38 !important;
                        stroke-opacity: 0.78 !important;
                    }

                    text {
                        display: none !important;
                    }
                """)
            except Exception as e:
                print("Aviso CSS glow mapa:", e)

            self._world_map_glow_handle = handle
            return handle

        except Exception as e:
            print("ERRO AO CARREGAR GLOW DO MAPA:", e)
            self._world_map_glow_handle = None
            return None


    def draw_world_map(self, area, cr, width, height):
        import math

        # ============================================================
        # FUNDO
        # ============================================================

        cr.set_source_rgb(0.012, 0.025, 0.065)
        cr.rectangle(0, 0, width, height)
        cr.fill()

        # Grade fina no estilo StackOS.
        cr.set_line_width(0.55)
        cr.set_source_rgba(0.18, 0.40, 0.80, 0.10)

        cols = 16
        rows = 8

        for i in range(1, cols):
            x = width * i / cols
            cr.move_to(x, 0)
            cr.line_to(x, height)

        for i in range(1, rows):
            y = height * i / rows
            cr.move_to(0, y)
            cr.line_to(width, y)

        cr.stroke()

        # Linha do Equador um pouco mais visivel.
        cr.set_source_rgba(0.24, 0.47, 0.85, 0.16)
        cr.set_line_width(0.7)
        cr.move_to(0, height * 0.5)
        cr.line_to(width, height * 0.5)
        cr.stroke()

        # ============================================================
        # MAPA VETORIAL
        # ============================================================

        glow_handle = self.get_world_map_glow_handle()

        if glow_handle is not None:
            try:
                visible_height = height * 0.82

                # Renderizamos o proprio mapa varias vezes com
                # pequenos deslocamentos e baixa opacidade.
                # Isso cria um halo que segue os continentes.
                cr.save()

                cr.rectangle(
                    0,
                    0,
                    width,
                    visible_height
                )
                cr.clip()

                cr.push_group()

                glow_offsets = (
                    (-2.0,  0.0),
                    ( 2.0,  0.0),
                    ( 0.0, -2.0),
                    ( 0.0,  2.0),
                    (-1.4, -1.4),
                    ( 1.4, -1.4),
                    (-1.4,  1.4),
                    ( 1.4,  1.4),
                )

                for dx, dy in glow_offsets:
                    cr.save()

                    viewport = Rsvg.Rectangle()
                    viewport.x = dx
                    viewport.y = dy
                    viewport.width = width
                    viewport.height = height

                    glow_handle.render_document(
                        cr,
                        viewport
                    )

                    cr.restore()

                glow_pattern = cr.pop_group()

                cr.set_source(glow_pattern)
                cr.paint_with_alpha(0.16)

                cr.restore()

            except Exception as e:
                print("ERRO AO RENDERIZAR GLOW DO MAPA:", e)

        # Camada principal, nitida.
        handle = self.get_world_map_handle()

        if handle is not None:
            try:
                # Oculta apenas a faixa da Antartida.
                # O SVG NAO e deslocado nem redimensionado,
                # preservando o alinhamento exato das cidades.
                cr.save()

                visible_height = height * 0.82

                cr.rectangle(
                    0,
                    0,
                    width,
                    visible_height
                )
                cr.clip()

                viewport = Rsvg.Rectangle()
                viewport.x = 0
                viewport.y = 0
                viewport.width = width
                viewport.height = height

                handle.render_document(cr, viewport)

                cr.restore()

            except Exception as e:
                print("ERRO AO RENDERIZAR MAPA:", e)

        selected_tz = getattr(
            self,
            "map_selected_timezone",
            self.timezone
        )

        # ============================================================
        # AJUSTES DE LABEL
        #
        # dx, dy permitem evitar sobreposicao principalmente na Europa.
        # ============================================================

        label_offsets = {
            "Sao Paulo":    (8, 4),
            "Manaus":       (8, -7),
            "New York":     (7, 11),
            "Chicago":      (-4, -8),
            "Denver":       (-4, -8),
            "Los Angeles":  (-58, 3),
            "Mexico City":  (-51, 14),
            "Bogota":       (7, 12),
            "Buenos Aires": (7, 13),
            "Santiago":     (-49, 3),

            "Lisboa":       (-39, 14),
            "London":       (-33, -9),
            "Madrid":       (-34, 15),
            "Paris":        (-31, 3),
            "Amsterdam":    (-18, -16),
            "Berlin":       (7, -8),
            "Warsaw":       (7, -9),
            "Rome":         (7, 13),
            "Istanbul":     (7, 12),
            "Moscow":       (7, -8),

            "Tokyo":        (8, 4),
        }

        # ============================================================
        # CIDADES
        # ============================================================

        for name, timezone, x, y in self.MAP_LOCATIONS:
            px = x * width
            py = y * height

            selected = timezone == selected_tz

            if selected:
                # Halo externo.
                cr.set_source_rgba(0.48, 0.18, 0.97, 0.10)
                cr.arc(px, py, 22, 0, math.tau)
                cr.fill()

                # Halo intermediario.
                cr.set_source_rgba(0.48, 0.18, 0.97, 0.22)
                cr.arc(px, py, 15, 0, math.tau)
                cr.fill()

                # Anel.
                cr.set_source_rgba(0.55, 0.20, 1.0, 0.92)
                cr.set_line_width(2.2)
                cr.arc(px, py, 9, 0, math.tau)
                cr.stroke()

                # Centro.
                cr.set_source_rgb(0.55, 0.20, 1.0)
                cr.arc(px, py, 6.2, 0, math.tau)
                cr.fill()

                cr.set_source_rgb(1.0, 1.0, 1.0)
                cr.arc(px, py, 2.1, 0, math.tau)
                cr.fill()

            else:
                # Pequeno halo azul.
                cr.set_source_rgba(0.24, 0.47, 0.85, 0.16)
                cr.arc(px, py, 6.5, 0, math.tau)
                cr.fill()

                cr.set_source_rgb(0.22, 0.52, 1.0)
                cr.arc(px, py, 3.3, 0, math.tau)
                cr.fill()

            # ========================================================
            # NOMES DAS CIDADES
            # ========================================================

            if selected:
                dx, dy = label_offsets.get(name, (7, 4))

                cr.set_source_rgba(1.0, 1.0, 1.0, 1.0)
                cr.set_font_size(11.5)

                cr.move_to(px + dx, py + dy)
                cr.show_text(name)

    def on_map_click(self, gesture, n_press, x, y):
        area = gesture.get_widget()
        width = area.get_width()
        height = area.get_height()

        if width <= 0 or height <= 0:
            return

        nearest = None
        nearest_distance = 999999

        for name, timezone, px, py in self.MAP_LOCATIONS:
            mx = px * width
            my = py * height

            distance = ((x - mx) ** 2 + (y - my) ** 2) ** 0.5

            if distance < nearest_distance:
                nearest_distance = distance
                nearest = (name, timezone)

        # Qualquer clique valido no mapa seleciona
        # automaticamente a regiao suportada mais proxima.
        if nearest is None:
            return

        name, timezone = nearest

        try:
            index = self.tz_values.index(timezone)
        except ValueError:
            return

        self.tz_combo.set_selected(index)
        self.map_selected_timezone = timezone

        try:
            region = self.tz_names[index]
        except Exception:
            region = name

        self.update_map_info(region, timezone)

        self.world_map.queue_draw()

    def update_map_info(self, region, timezone):
        if hasattr(self, "map_region_label"):
            self.map_region_label.set_text(region)

        if hasattr(self, "map_timezone_label"):
            self.map_timezone_label.set_text(timezone)

        if hasattr(self, "map_utc_label"):
            try:
                now = datetime.now(ZoneInfo(timezone))
                offset = now.utcoffset()

                if offset is None:
                    utc_text = "UTC"
                else:
                    total = int(offset.total_seconds() // 60)
                    sign = "+" if total >= 0 else "-"
                    total = abs(total)

                    hours = total // 60
                    minutes = total % 60

                    utc_text = f"UTC{sign}{hours:02d}:{minutes:02d}"

                self.map_utc_label.set_text(utc_text)

            except Exception:
                self.map_utc_label.set_text("UTC")


    def on_timezone_changed(self, combo, pspec):
        index = combo.get_selected()

        if index < 0 or index >= len(self.tz_values):
            return

        self.map_selected_timezone = self.tz_values[index]

        label = self.tz_names[index]

        self.update_map_info(
            label,
            self.map_selected_timezone
        )

        if hasattr(self, "world_map"):
            self.world_map.queue_draw()

