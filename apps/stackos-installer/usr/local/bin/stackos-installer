#!/usr/bin/env python3
# [NODUALBOOT-20260916] Candidato sem Dual Boot. Original 2.2 intocado.
import os as _launcher_os, sys as _launcher_sys
if _launcher_os.geteuid() == 0 and _launcher_os.environ.get('SUDO_UID') and not _launcher_os.environ.get('STACKOS_INSTALLER_PRIVATE_BUS'):
    if _launcher_os.access('/usr/bin/dbus-run-session', _launcher_os.X_OK):
        _installer_environment = _launcher_os.environ.copy()
        _session_runtime = _installer_environment.get('XDG_RUNTIME_DIR', '')
        _wayland_socket = _installer_environment.get('WAYLAND_DISPLAY', '')
        if _wayland_socket and not _launcher_os.path.isabs(_wayland_socket):
            _installer_environment['WAYLAND_DISPLAY'] = _launcher_os.path.join(_session_runtime, _wayland_socket)
        _root_runtime = '/run/stackos-installer-root'
        _launcher_os.makedirs(_root_runtime, mode=0o700, exist_ok=True)
        if _launcher_os.path.islink(_root_runtime) or _launcher_os.stat(_root_runtime).st_uid != 0:
            raise RuntimeError('Diretório de sessão administrativa inválido')
        _launcher_os.chmod(_root_runtime, 0o700)
        _installer_environment['XDG_RUNTIME_DIR'] = _root_runtime
        _installer_environment['STACKOS_INSTALLER_PRIVATE_BUS'] = '1'
        _launcher_os.execve('/usr/bin/dbus-run-session', ['dbus-run-session', '--', '/usr/bin/python3', __file__, *_launcher_sys.argv[1:]], _installer_environment)

