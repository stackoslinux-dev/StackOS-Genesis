            ('Argentina - Buenos Aires',  'America/Argentina/Buenos_Aires'),
            ('Colombia - Bogota',         'America/Bogota'),
            ('Chile - Santiago',          'America/Santiago'),
            ('Japao - Tokyo',             'Asia/Tokyo'),
            ('Russia - Moscow',           'Europe/Moscow'),
            ('UTC',                       'UTC'),
        ]

        self.tz_combo = Gtk.DropDown.new_from_strings(
            [t[0] for t in timezones]
        )
        self.tz_combo.set_selected(0)
        self.tz_values = [t[1] for t in timezones]
        self.tz_names = [t[0] for t in timezones]
        left.append(self.tz_combo)

        map_title = Gtk.Label(
            label=self.tr("select_map")
        )
        map_title.add_css_class('label-blue')
        map_title.set_halign(Gtk.Align.START)
        right.append(map_title)

        self.world_map = Gtk.DrawingArea()
        self.world_map.set_content_width(240)
        self.world_map.set_content_height(250)
        self.world_map.set_hexpand(True)
        self.world_map.set_vexpand(True)
        self.world_map.set_draw_func(self.draw_world_map)

        click = Gtk.GestureClick()
        click.connect("pressed", self.on_map_click)
        self.world_map.add_controller(click)

        right.append(self.world_map)

        self.map_selected_timezone = self.timezone

        # Barra inferior do mapa.
        map_info = Gtk.Box(
            orientation=Gtk.Orientation.HORIZONTAL,
            spacing=18
        )
        map_info.add_css_class('map-info')
        map_info.set_margin_top(4)

        self.map_region_label = Gtk.Label(
            label="Brasil - Sao Paulo"
        )
        self.map_region_label.add_css_class('label-white')
        self.map_region_label.set_halign(Gtk.Align.START)
        self.map_region_label.set_hexpand(True)

        self.map_timezone_label = Gtk.Label(
            label="America/Sao_Paulo"
        )
        self.map_timezone_label.add_css_class('label-white')
        self.map_timezone_label.set_halign(Gtk.Align.CENTER)
        self.map_timezone_label.set_hexpand(True)

        self.map_utc_label = Gtk.Label(
            label="UTC-03:00"
        )
        self.map_utc_label.add_css_class('label-purple')
        self.map_utc_label.set_halign(Gtk.Align.END)
        self.map_utc_label.set_hexpand(True)

        map_info.append(self.map_region_label)
        map_info.append(self.map_timezone_label)
        map_info.append(self.map_utc_label)

        right.append(map_info)

        card.append(left)
        card.append(right)

        # Pre-selecao automatica baseada no idioma.
        self.locale_defaults = {
            0:  (0, 0),    # pt_BR -> ABNT2 / Sao Paulo
            1:  (2, 10),   # pt_PT -> PT / Lisboa
            2:  (3, 19),   # en_US -> US / New York
            3:  (4, 11),   # en_GB -> UK / London
            4:  (5, 12),   # es_ES -> ES / Madrid
            5:  (6, 23),   # es_MX -> LATAM / Mexico City
            6:  (7, 13),   # fr_FR -> FR / Paris
            7:  (8, 14),   # de_DE -> DE / Berlin
            8:  (9, 15),   # it_IT -> IT / Rome
            9:  (10, 16),  # nl_NL -> NL / Amsterdam
            10: (11, 17),  # pl_PL -> PL / Warsaw
            11: (12, 18),  # tr_TR -> TR / Istanbul
            12: (13, 28),  # ru_RU -> RU / Moscow
            13: (14, 27),  # ja_JP -> JP / Tokyo
        }

        # Aplica teclado e fuso correspondentes ao idioma
        # escolhido logo na primeira tela.
        current_locale_index = self.locale_combo.get_selected()

        if current_locale_index in self.locale_defaults:
            keyboard_index, timezone_index = (
                self.locale_defaults[current_locale_index]
            )

            self.keyboard_combo.set_selected(
                keyboard_index
            )

            self.tz_combo.set_selected(
                timezone_index
            )

        self.locale_combo.connect(
            "notify::selected",
            self.on_locale_changed
        )

        self.keyboard_combo.connect(
            "notify::selected",
            self.on_keyboard_changed
        )

        self.tz_combo.connect(
            "notify::selected",
            self.on_timezone_changed
        )

        # Sincroniza explicitamente o mapa com o timezone
        # que foi pre-selecionado antes dos sinais existirem.
        # Aplica tambem o teclado pre-selecionado
        # automaticamente pelo idioma.
        self.on_keyboard_changed(
            self.keyboard_combo,
            None
        )

        current_tz_index = self.tz_combo.get_selected()

        if 0 <= current_tz_index < len(self.tz_values):
            self.map_selected_timezone = self.tz_values[current_tz_index]

            self.update_map_info(
                self.tz_names[current_tz_index],
                self.map_selected_timezone
            )

            self.world_map.queue_draw()

        box.append(card)
        nav, btn = self.make_nav(
            back_cb=lambda b: self.show_confirm_erase() if self.mode == "erase" else self.show_dual_size(),
            next_label=self.tr("install"),
            next_cb=lambda b: self.on_locale_next(),
            next_style='btn-danger'
        )
        box.append(nav)
        self.present_page(box, 'locale')

    def apply_keyboard_preview(self, layout, variant):
        if self.preview:
            return
        source = layout + ('+' + variant if variant else '')
        command = ['gsettings','set','org.gnome.desktop.input-sources','sources',"[('xkb', '"+source+"')]"]
        if os.geteuid() == 0:
            import pwd
            username = os.environ.get('SUDO_USER', 'stackos')
            if username == 'root':
                username = 'stackos'
            uid = pwd.getpwnam(username).pw_uid
            command = ['sudo','-H','-u',username,'env','XDG_RUNTIME_DIR=/run/user/'+str(uid),'DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/'+str(uid)+'/bus'] + command
        result = subprocess.run(command, capture_output=True, text=True, timeout=15)
        if result.returncode:
            Gtk.AlertDialog(message='Não foi possível aplicar o teclado', detail=result.stderr).show(self.win)

    def on_keyboard_changed(self, combo, pspec):
        index = combo.get_selected()

        if (
            index < 0 or
            index >= len(self.keyboard_values)
        ):
            return

        layout, variant = (
            self.keyboard_values[index]
        )

        self.apply_keyboard_preview(
            layout,
            variant
        )

    def on_locale_changed(self, combo, pspec):
        index = combo.get_selected()

        if index not in self.locale_defaults:
            return

        keyboard_index, timezone_index = self.locale_defaults[index]

        self.keyboard_combo.set_selected(keyboard_index)
        self.tz_combo.set_selected(timezone_index)

        # Atualiza imediatamente o estado visual do mapa.
        if 0 <= timezone_index < len(self.tz_values):
            self.map_selected_timezone = self.tz_values[timezone_index]

            self.update_map_info(
                self.tz_names[timezone_index],
                self.map_selected_timezone
            )

            self.world_map.queue_draw()

    def on_locale_next(self):
        self.locale = self.locale_values[self.locale_combo.get_selected()]
        self.timezone = self.tz_values[self.tz_combo.get_selected()]

        keyboard = self.keyboard_values[
            self.keyboard_combo.get_selected()
        ]
        self.keyboard_layout = keyboard[0]
        self.keyboard_variant = keyboard[1]

        self.ui_lang = self.locale.split('.')[0]
        os.environ['LANG'] = self.locale
        os.environ['LANGUAGE'] = self.ui_lang + ':' + self.ui_lang.split('_')[0]
        self.show_installing()

    # ------------------------------------------------------------------
    # TELA DE INSTALACAO  (refinada: carrossel de slides + barra real)
    # ------------------------------------------------------------------
    SLIDE_ICONS = [
        "⚡",
        "🎨",
        "📦",
        "🛒",
        "💬",
    ]

    def show_installing(self):
        if self.installing:
            return
        if not self.preview:
            try:
                self.validate_install_target()
            except Exception as error:
                Gtk.AlertDialog(message="Não foi possível iniciar a instalação", detail=str(error)).show(self.win)
                return
        self.installing = not self.preview
        self.install_failed = False
        self.clear()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        box.set_margin_top(30)
        box.set_margin_bottom(30)
        box.set_margin_start(60)
        box.set_margin_end(60)
        box.append(self.make_header(self.tr("installing_title")))

        # --- carrossel de slides ---
        self.SLIDES = [
            (
                self.SLIDE_ICONS[0],
                self.tr("slide1_title"),
                self.tr("slide1_text"),
            ),
            (
                self.SLIDE_ICONS[1],
                self.tr("slide2_title"),
                self.tr("slide2_text"),
            ),
            (
                self.SLIDE_ICONS[2],
                self.tr("slide3_title"),
                self.tr("slide3_text"),
            ),
            (
                self.SLIDE_ICONS[3],
                self.tr("slide4_title"),
                self.tr("slide4_text"),
            ),
            (
                self.SLIDE_ICONS[4],
                self.tr("slide5_title"),
                self.tr("slide5_text"),
            ),
        ]

        self.slide_stack = Gtk.Stack()
        self.slide_stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self.slide_stack.set_transition_duration(450)
        self.slide_stack.set_vexpand(True)
        self.slide_stack.set_hexpand(True)

        for i, (icon, title, text) in enumerate(self.SLIDES):
            sc = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
            sc.add_css_class('slide-card')
            sc.set_valign(Gtk.Align.CENTER)
            sc.set_halign(Gtk.Align.FILL)

            l_icon = Gtk.Image.new_from_file('/usr/share/stackos-installer/stackos-symbol.png')
            l_icon.set_pixel_size(56)
            l_icon.add_css_class('slide-icon')
            sc.append(l_icon)

            l_title = Gtk.Label(label=title)
            l_title.add_css_class('slide-title')
            l_title.set_justify(Gtk.Justification.CENTER)
            sc.append(l_title)

            l_text = Gtk.Label(label=text)
            l_text.add_css_class('slide-text')
            l_text.set_justify(Gtk.Justification.CENTER)
            l_text.set_wrap(True)
            sc.append(l_text)

            self.slide_stack.add_named(sc, f"slide{i}")

        box.append(self.slide_stack)

        # --- pontinhos indicadores ---
        self.dots_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.dots_box.set_halign(Gtk.Align.CENTER)
        self.dots_box.set_margin_top(14)
        self.dots = []
        for i in range(len(self.SLIDES)):
            d = Gtk.Label(label="\u25cf")
            d.add_css_class('dot-on' if i == 0 else 'dot-off')
            self.dots.append(d)
            self.dots_box.append(d)
        box.append(self.dots_box)

        # --- status + barra + percentual ---
        self.lbl_status = Gtk.Label(label=self.tr("starting"))
        self.lbl_status.add_css_class('label-white')
        self.lbl_status.set_justify(Gtk.Justification.CENTER)
        self.lbl_status.set_margin_top(18)
        box.append(self.lbl_status)

        self.progress = Gtk.ProgressBar()
        self.progress.add_css_class('progress')
        self.progress.set_fraction(0.0)
        self.progress.set_margin_top(8)
        box.append(self.progress)

        self.lbl_pct = Gtk.Label(label="0%")
        self.lbl_pct.add_css_class('pct')
        self.lbl_pct.set_halign(Gtk.Align.END)
        self.lbl_pct.set_margin_top(4)
        box.append(self.lbl_pct)

        self.present_page(box, 'installing')

        # estado do carrossel e da animacao da barra
        self.slide_idx = 0
        self.target_fraction = 0.0
        self.shown_fraction = 0.0

        self.install_thread = threading.Thread(target=self.install_worker, daemon=True)
        self.install_thread.start()

        # troca de slide a cada 7s; anima a barra suavemente a cada 50ms
        self.slide_timer = GLib.timeout_add_seconds(7, self.next_slide)
        GLib.timeout_add(50, self.animate_bar)

    def next_slide(self):
        if not self.install_thread.is_alive():
            return False
        self.dots[self.slide_idx].remove_css_class('dot-on')
        self.dots[self.slide_idx].add_css_class('dot-off')
        self.slide_idx = (self.slide_idx + 1) % len(self.SLIDES)
        self.slide_stack.set_visible_child_name(f"slide{self.slide_idx}")
        self.dots[self.slide_idx].remove_css_class('dot-off')
        self.dots[self.slide_idx].add_css_class('dot-on')
        return True

    def animate_bar(self):
        # aproxima suavemente a barra mostrada do alvo definido por set_progress
        if self.shown_fraction < self.target_fraction:
            self.shown_fraction = min(self.target_fraction, self.shown_fraction + 0.004)
            self.progress.set_fraction(self.shown_fraction)
            self.lbl_pct.set_text(f"{int(self.shown_fraction*100)}%")
        if self.install_failed or (not self.install_thread.is_alive() and self.shown_fraction >= 0.999):
            return False
        return True

    def set_progress(self, fraction, msg):
        # chamado de dentro da thread de instalacao; agenda update na UI thread
        def apply():
            self.target_fraction = fraction
            self.lbl_status.set_text(msg)
            return False
        GLib.idle_add(apply)

    # mantido por compatibilidade: redireciona texto antigo pra barra
    def set_status(self, msg):
        GLib.idle_add(self.lbl_status.set_text, msg)

    def validate_install_target(self):
        if os.geteuid() != 0:
            raise RuntimeError("Abra o instalador pelo atalho administrativo do StackOS.")
        if not re.fullmatch(r'/dev/[a-zA-Z0-9._-]+', self.disk) or not stat.S_ISBLK(os.stat(self.disk).st_mode):
            raise RuntimeError("Selecione um disco de instalação válido.")
        data = json.loads(run(['lsblk', '--json', '--bytes', '--output', 'PATH,TYPE,SIZE,MOUNTPOINTS', self.disk]).stdout)
        target = data['blockdevices'][0]
        if target['type'] != 'disk':
            raise RuntimeError("O destino deve ser um disco inteiro.")
        if self.mode == 'erase' and int(target['size']) < 40 * 1024**3:
            raise RuntimeError("Este esquema com sistema, recuperação e backups precisa de um disco de pelo menos 40 GiB.")
        def check_mounts(device):
            if any(device.get('mountpoints') or []):
                raise RuntimeError("O disco selecionado está em uso. Desmonte suas partições antes de instalar.")
            for child in device.get('children', []):
                check_mounts(child)
        check_mounts(target)
        if os.path.ismount('/mnt/stackos-install'):
            raise RuntimeError("Já existe uma instalação montada em /mnt/stackos-install.")
        if not Path('/sys/firmware/efi').is_dir():
            raise RuntimeError("Esta versão do instalador prepara GRUB UEFI. Reinicie a mídia em modo UEFI antes de instalar.")
        if self.mode not in ('erase', 'dual'):
            raise RuntimeError("Conclua a seleção do modo de instalação.")
        media = [Path('/cdrom/casper'), Path('/cdrom/live'), Path('/run/live/medium/live')]
        self.live_source = next((base for base in media if (base/'filesystem.squashfs').is_file() and (base/'vmlinuz').is_file()), None)
        if self.live_source is None:
            raise RuntimeError("A mídia live não contém filesystem.squashfs e vmlinuz. Nenhum disco foi alterado.")
        for command in ('wipefs', 'parted', 'partprobe', 'mkfs.fat', 'mkfs.ext4', 'unsquashfs', 'mount', 'chroot'):
            if shutil.which(command) is None:
                raise RuntimeError("Ferramenta necessária não encontrada: " + command)

    def install_worker(self):
        try:
            self.do_install()
        except Exception as error:
            detail = str(error)
            log = Path('/var/log/stackos-installer.log')
            try:
                log.write_text(traceback.format_exc())
            except OSError:
                pass
            GLib.idle_add(self.show_install_error, detail)

    def show_install_error(self, detail):
        self.installing = False
        self.install_failed = True
        self.clear()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        box.append(self.make_header('A instalação foi interrompida'))
        message = Gtk.Label(label=detail, wrap=True, selectable=True, xalign=0)
        message.add_css_class('warn-erase')
        box.append(message)
        box.append(Gtk.Label(label='Não reinicie supondo que a instalação terminou. O disco pode estar parcialmente alterado. Detalhes em /var/log/stackos-installer.log.', wrap=True, xalign=0))
        button = Gtk.Button(label='Fechar instalador')
        button.add_css_class('btn-secondary')
        button.connect('clicked', lambda b: self.quit())
        box.append(button)
        self.present_page(box, 'installing')
        self.step_label.set_text('Instalação interrompida')
        return False

    def copy_live_system(self):
        command = ['unsquashfs','-percentage','-processors','2','-f','-d','/mnt/stackos-install',str(self.live_source/'filesystem.squashfs')]
        with subprocess.Popen(command,stdout=subprocess.PIPE,stderr=subprocess.STDOUT) as process:
            history = b''
            last = -1
            while True:
                chunk = process.stdout.read(128)
                if not chunk:
                    break
                history = (history + chunk)[-8000:]
                percentages = re.findall(rb'(\d+(?:\.\d+)?)%', history)
                if percentages:
                    value = min(100, int(float(percentages[-1])))
                    if value > last:
                        last = value
                        self.set_progress(0.25 + 0.40 * value / 100, self.tr('copying_system') + f' {value}%')
            result = process.wait()
            if result:
                raise CommandError('Não foi possível copiar o sistema: ' + history.decode(errors='replace'))

    def do_install(self):
        if self.preview:
            self.set_progress(0, "Prévia visual — nenhuma alteração nos discos.")
            return
        disk = self.disk

        if self.mode == 'erase':
            self.set_progress(0.05, self.tr("partitioning"))

            if "nvme" in disk or "mmcblk" in disk:
                self.efi = disk + "p1"
                self.root = disk + "p2"
                self.recovery = disk + "p3"
                self.backups = disk + "p4"
            else:
                self.efi = disk + "1"
                self.root = disk + "2"
                self.recovery = disk + "3"
                self.backups = disk + "4"

            # StackOS GPT:
            # p1 = EFI 300 MiB
            # p2 = sistema
            # p3 = Recovery protegido, últimos 6 GiB.
            run("wipefs -af " + disk)
            run(['parted', '-s', disk, 'mklabel', 'gpt'])
            size = int(run(['blockdev', '--getsize64', disk]).stdout)
            end_mib = size // 1024**2
            root_end = end_mib - 22 * 1024
            recovery_end = root_end + 6 * 1024
            run(['parted', '-s', disk, 'unit', 'MiB', 'mkpart', 'EFI', 'fat32', '1', '301'])
            run(['parted', '-s', disk, 'set', '1', 'esp', 'on'])
            run(['parted', '-s', disk, 'unit', 'MiB', 'mkpart', 'ROOT', 'ext4', '301', str(root_end)])
            run(['parted', '-s', disk, 'unit', 'MiB', 'mkpart', 'STACKOS_RECOVERY', 'ext4', str(root_end), str(recovery_end)])
            run(['parted', '-s', disk, 'unit', 'MiB', 'mkpart', 'STACKOS_BACKUPS', 'ext4', str(recovery_end), '100%'])

            run("partprobe " + disk)
            time.sleep(2)

            run("mkfs.fat -F32 " + self.efi)
            run("mkfs.ext4 -F " + self.root)
            run("mkfs.ext4 -F -L STACKOS_RECOVERY " + self.recovery)
            run("mkfs.ext4 -F -L STACKOS_BACKUPS " + self.backups)

        elif self.mode == 'dual':
            self.set_progress(0.05, self.tr("dual_partitioning"))
            efi_start = self.dual_start
            efi_end = self.dual_start + 300
            root_start = efi_end
            root_end = root_start + self.dual_size
            run(f"parted -s -a optimal {disk} mkpart primary fat32 {efi_start}MiB {efi_end}MiB")
            run(f"parted -s -a optimal {disk} mkpart primary ext4 {root_start}MiB {root_end}MiB")
            run(f"partprobe {disk}")
            time.sleep(2)
            lsblk2 = subprocess.run(['lsblk','-rno','NAME,FSTYPE,MOUNTPOINT'], capture_output=True, text=True)
            disk_base = disk.replace('/dev/','')
            new_parts = []
            for line in lsblk2.stdout.splitlines():
                parts = line.strip().split()
                name = parts[0] if parts else ''
                fstype = parts[1] if len(parts) > 1 else ''
                mountpoint = parts[2] if len(parts) > 2 else ''
                if disk_base in name and name != disk_base and fstype in ['','vfat','ext4'] and mountpoint == '':
                    new_parts.append(f'/dev/{name}')
            self.efi = new_parts[-2]
            self.root = new_parts[-1]
            run(f"mkfs.fat -F32 {self.efi}")
            run(f"mkfs.ext4 -F {self.root}")

        self.set_progress(0.15, self.tr("mounting"))
        run("mkdir -p /mnt/stackos-install")
        run("mount " + self.root + " /mnt/stackos-install")
        run("mkdir -p /mnt/stackos-install/boot/efi")
        run("mount " + self.efi + " /mnt/stackos-install/boot/efi")

        if self.mode == 'erase' and self.recovery:
            run("mkdir -p /mnt/stackos-recovery")
            run("mount " + self.recovery + " /mnt/stackos-recovery")
            run("mkdir -p /mnt/stackos-recovery/factory")
            run("mkdir -p /mnt/stackos-recovery/boot/grub")

        if self.mode == 'erase' and self.backups:
            run("mkdir -p /mnt/stackos-backups")
            run("mount " + self.backups + " /mnt/stackos-backups")
            run("mkdir -p /mnt/stackos-backups/snapshots")
            run("chmod 700 /mnt/stackos-backups/snapshots")

        self.set_progress(0.25, self.tr("copying_system"))
        self.copy_live_system()

        self.set_progress(0.68, self.tr("copying_kernel"))

        module_root = "/mnt/stackos-install/usr/lib/modules"

        kernel_versions = sorted(
            [
                name
                for name in os.listdir(module_root)
                if os.path.isdir(
                    os.path.join(module_root, name)
                )
            ]
        )

        if not kernel_versions:
            raise RuntimeError(
                "Kernel instalado nao encontrado"
            )

        kernel_version = kernel_versions[-1]

        run(
            "cp -a " + shlex.quote(str(self.live_source / "vmlinuz")) + " "
            "/mnt/stackos-install/boot/vmlinuz-" +
            kernel_version
        )

        run(
            "ln -sfn vmlinuz-" +
            kernel_version +
            " /mnt/stackos-install/boot/vmlinuz"
        )

        self.set_progress(0.74, self.tr("preparing_initial"))

        #
        # StackOS FirstBoot
        #
        # O pacote stackos-firstboot mantém templates permanentes em:
        #
        #   /usr/lib/stackos/firstboot/
        #
        # O instalador cria somente as cópias temporárias usadas no
        # primeiro boot do sistema instalado.
        #

        firstboot_template_root = (
            "/mnt/stackos-install/usr/lib/stackos/firstboot"
        )

        firstboot_frontend_template = os.path.join(
            firstboot_template_root,
            "stackos-firstboot"
        )

        firstboot_helper_template = os.path.join(
            firstboot_template_root,
            "stackos-firstboot-helper"
        )

        firstboot_cleanup_template = os.path.join(
            firstboot_template_root,
            "stackos-firstboot-cleanup"
        )

        firstboot_desktop_template = os.path.join(
            firstboot_template_root,
            "stackos-firstboot.desktop"
        )

        required_firstboot_templates = [
            firstboot_frontend_template,
            firstboot_helper_template,
            firstboot_cleanup_template,
            firstboot_desktop_template,
        ]

        for template in required_firstboot_templates:
            if not os.path.isfile(template):
                raise RuntimeError(
                    "Template FirstBoot ausente: " + template
                )

        os.makedirs(
            "/mnt/stackos-install/usr/local/bin",
            exist_ok=True
        )

        os.makedirs(
            "/mnt/stackos-install/usr/lib/stackos",
            exist_ok=True
        )

        os.makedirs(
            "/mnt/stackos-install/etc/xdg/autostart",
            exist_ok=True
        )

        os.makedirs(
            "/mnt/stackos-install/usr/share/applications",
            exist_ok=True
        )

        os.makedirs(
            "/mnt/stackos-install/etc/sudoers.d",
            exist_ok=True
        )

        os.makedirs(
            "/mnt/stackos-install/etc/gdm",
            exist_ok=True
        )

        os.makedirs(
            "/mnt/stackos-install/var/lib/stackos",
            exist_ok=True
        )

        run(
            "install -m 755 "
            + firstboot_frontend_template
            + " /mnt/stackos-install/usr/local/bin/stackos-firstboot"
        )

        run(
            "install -m 755 "
            + firstboot_helper_template
            + " /mnt/stackos-install/usr/lib/stackos/"
            "stackos-firstboot-helper"
        )

        run(
            "install -m 755 "
            + firstboot_cleanup_template
            + " /mnt/stackos-install/usr/lib/stackos/"
            "stackos-firstboot-cleanup"
        )

        run(
            "install -m 644 "
            + firstboot_desktop_template
            + " /mnt/stackos-install/etc/xdg/autostart/"
            "stackos-firstboot.desktop"
        )

        run(
            "install -m 644 "
            + firstboot_desktop_template
            + " /mnt/stackos-install/usr/share/applications/"
            "stackos-firstboot.desktop"
        )

        with open(
            "/mnt/stackos-install/etc/sudoers.d/stackos-firstboot",
            "w"
        ) as f:
            f.write(
                "stackos ALL=(root) NOPASSWD: "
                "/usr/lib/stackos/stackos-firstboot-helper\n"
            )

        os.chmod(
            "/mnt/stackos-install/etc/sudoers.d/stackos-firstboot",
            0o440
        )

        with open(
            "/mnt/stackos-install/etc/gdm/custom.conf",
            "w"
        ) as f:
            f.write(
                "[daemon]\n"
                "AutomaticLoginEnable=true\n"
                "AutomaticLogin=stackos\n"
                "\n"
                "[security]\n"
                "AllowRoot=false\n"
            )

        with open(
            "/mnt/stackos-install/var/lib/stackos/firstboot-pending",
            "w"
        ) as f:
            f.write("pending\n")

        run(
            "chroot /mnt/stackos-install "
            "sh -c 'id stackos >/dev/null 2>&1 || "
            "useradd -m -s /bin/bash -G "
            "sudo,adm,audio,video,plugdev,netdev,lpadmin stackos'"
        )

        run(
            "chroot /mnt/stackos-install "
            "sh -c \"echo stackos:stackos | chpasswd\""
        )

        run(
            "chroot /mnt/stackos-install "
            "chown -R stackos:stackos /home/stackos",
            check=False
        )

        required_firstboot_runtime = [
            "/mnt/stackos-install/usr/local/bin/stackos-firstboot",
            "/mnt/stackos-install/usr/lib/stackos/"
            "stackos-firstboot-helper",
            "/mnt/stackos-install/usr/lib/stackos/"
            "stackos-firstboot-cleanup",
            "/mnt/stackos-install/etc/xdg/autostart/"
            "stackos-firstboot.desktop",
            "/mnt/stackos-install/usr/share/applications/"
            "stackos-firstboot.desktop",
        ]

        for runtime_file in required_firstboot_runtime:
            if not os.path.isfile(runtime_file):
                raise RuntimeError(
                    "FirstBoot runtime nao preparado: "
                    + runtime_file
                )

        run(
            "chroot /mnt/stackos-install ln -sf "
            "/usr/share/zoneinfo/" + self.timezone +
            " /etc/localtime",
            check=False
        )

        # Locale escolhido
        locale_gen = "/mnt/stackos-install/etc/locale.gen"

        try:
            with open(locale_gen, "r") as f:
                locale_lines = f.readlines()
        except Exception:
            locale_lines = []

        wanted = self.locale + " UTF-8"

        if not any(
            line.strip().lstrip("#").strip() == wanted
            for line in locale_lines
        ):
            locale_lines.append(wanted + "\n")
        else:
            locale_lines = [
                (
                    wanted + "\n"
                    if line.strip().lstrip("#").strip() == wanted
                    else line
                )
                for line in locale_lines
            ]

        with open(locale_gen, "w") as f:
            f.writelines(locale_lines)

        run(
            "chroot /mnt/stackos-install /usr/lib/stackos/stackos-set-language " + shlex.quote(self.locale.split(".")[0]),
            check=False
        )

        with open(
            "/mnt/stackos-install/etc/default/locale",
            "w"
        ) as f:
            f.write("LANG=" + self.locale + "\n")

            locale_base = self.locale.split(".")[0]
            language_base = locale_base.split("_")[0]

            f.write(
                "LANGUAGE=" +
                locale_base +
                ":" +
                language_base +
                "\n"
            )

        locale_text = Path('/mnt/stackos-install/etc/default/locale').read_text()
        Path('/mnt/stackos-install/etc/locale.conf').write_text(locale_text)
        Path('/mnt/stackos-install/etc/vconsole.conf').write_text('KEYMAP=' + ('br-abnt2' if self.keyboard_layout == 'br' else 'us') + '\n')
        # Teclado escolhido
        with open(
            "/mnt/stackos-install/etc/default/keyboard",
            "w"
        ) as f:
            f.write('XKBMODEL="pc105"\n')
            f.write(
                'XKBLAYOUT="' +
                self.keyboard_layout +
                '"\n'
            )
            f.write(
                'XKBVARIANT="' +
                self.keyboard_variant +
                '"\n'
            )
            f.write('XKBOPTIONS=""\n')
            f.write('\nBACKSPACE="guess"\n')

        self.set_progress(0.84, self.tr("configuring_fstab"))
        root_uuid = run("blkid -s UUID -o value " + self.root).stdout.strip()
        efi_uuid = run("blkid -s UUID -o value " + self.efi).stdout.strip()
        fstab = "UUID=" + root_uuid + " / ext4 errors=remount-ro 0 1\n"
        fstab += "UUID=" + efi_uuid + " /boot/efi vfat umask=0077 0 1\n"
        with open("/mnt/stackos-install/etc/fstab", "w") as f:
            f.write(fstab)

        self.set_progress(0.90, self.tr("installing_grub"))

        # -----------------------------------------------------
        # Montagens necessárias ao sistema instalado
        # -----------------------------------------------------

        run("mount --bind /dev /mnt/stackos-install/dev")
        run("mount --bind /proc /mnt/stackos-install/proc")
        run("mount --bind /sys /mnt/stackos-install/sys")

        run(
            "mount --bind /sys/firmware/efi/efivars "
            "/mnt/stackos-install/sys/firmware/efi/efivars",
            check=False
        )

        # -----------------------------------------------------
        # Remove componentes Casper da instalação normal.
        # A sessão Live continua intacta.
        # -----------------------------------------------------

        run(
            "find /mnt/stackos-install/usr/share/initramfs-tools/scripts "
            "-maxdepth 1 -name 'casper*' -exec rm -rf {} +",
            check=False
        )

        run(
            "find /mnt/stackos-install/usr/share/initramfs-tools/hooks "
            "-maxdepth 1 -name 'casper*' -exec rm -rf {} +",
            check=False
        )

        # -----------------------------------------------------
        # Gera INITRAMFS REAL DO SISTEMA INSTALADO
        # -----------------------------------------------------

        initramfs_builder = (
            "/mnt/stackos-install/usr/lib/stackos/"
            "stackos-build-installed-initramfs"
        )

        if not os.path.isfile(initramfs_builder):
            raise RuntimeError(
                "Gerador do initramfs instalado não encontrado"
            )

        run(
            "chroot /mnt/stackos-install "
            "/usr/lib/stackos/stackos-build-installed-initramfs " +
            kernel_version
        )

        installed_initrd = (
            "/mnt/stackos-install/boot/initrd.img-" +
            kernel_version
        )

        if not os.path.isfile(installed_initrd):
            raise RuntimeError(
                "Initramfs instalado não foi criado"
            )

        # -----------------------------------------------------
        # RECOVERY INDEPENDENTE NA P3
        # -----------------------------------------------------

        if self.mode == 'erase' and self.recovery:

            recovery_uuid = run(
                "blkid -s UUID -o value " +
                self.recovery
            ).stdout.strip()

            root_partuuid = run(
                "blkid -s PARTUUID -o value " +
                self.root
            ).stdout.strip()

            if not recovery_uuid:
                raise RuntimeError(
                    "UUID da partição Recovery não encontrado"
                )

            if not root_partuuid:
                raise RuntimeError(
                    "PARTUUID da partição raiz não encontrado"
                )

            run(
                "mkdir -p "
                "/mnt/stackos-recovery/boot/grub"
            )

            run(
                "cp -a "
                "/mnt/stackos-install/boot/vmlinuz-" +
                kernel_version +
                " /mnt/stackos-recovery/boot/"
                "vmlinuz-recovery"
            )

            run(
                "cp -a " +
                installed_initrd +
                " /mnt/stackos-recovery/boot/"
                "initrd-recovery.img"
            )

            # -------------------------------------------------
            # Configuração inicial do GRUB.
            # Instalação limpa = nenhum backup ainda.
            # -------------------------------------------------

            grub_base = (
                "set default=0\n"
                "set timeout=5\n"
                "\n"
                "menuentry 'StackOS Genesis' {\n"
                "    search --no-floppy --fs-uuid "
                "--set=root " + root_uuid + "\n"
                "    linux /boot/vmlinuz "
                "root=UUID=" + root_uuid + " "
                "quiet splash console=ttyS0,115200 console=tty0 plymouth.enable=1 "
                "loglevel=3 "
                "systemd.show_status=false "
                "rd.systemd.show_status=false "
                "udev.log_priority=3 "
                "vt.global_cursor_default=0\n"
                "    initrd /boot/initrd.img\n"
                "}\n"
                "\n"
                "submenu 'StackOS Recovery' {\n"
                "\n"
                "    submenu 'Restaurar de fábrica' {\n"
                "\n"
                "        menuentry 'Cancelar e iniciar StackOS' {\n"
                "            search --no-floppy --fs-uuid "
                "--set=root " + root_uuid + "\n"
                "            linux /boot/vmlinuz "
                "root=UUID=" + root_uuid + " "
                "quiet splash console=ttyS0,115200 console=tty0\n"
                "            initrd /boot/initrd.img\n"
                "        }\n"
                "\n"
                "        menuentry "
                "'CONFIRMAR - apagar sistema e restaurar fábrica' {\n"
                "            search --no-floppy --fs-uuid "
                "--set=root " + recovery_uuid + "\n"
                "            linux /boot/vmlinuz-recovery "
                "root=UUID=" + root_uuid + " "
                "stackos.root-partuuid=" + root_partuuid + " "
                "stackos.factory-reset=1 "
                "stackos.confirm=yes ro\n"
                "            initrd /boot/initrd-recovery.img\n"
                "        }\n"
                "    }\n"
                "}\n"
            )

            with open(
                "/mnt/stackos-recovery/boot/grub/"
                "grub-base.cfg",
                "w"
            ) as f:
                f.write(grub_base)

            with open(
                "/mnt/stackos-recovery/boot/grub/"
                "grub.cfg",
                "w"
            ) as f:
                f.write(grub_base)

            # Root recebe somente um espelho.
            os.makedirs(
                "/mnt/stackos-install/boot/grub",
                exist_ok=True
            )

            with open(
                "/mnt/stackos-install/boot/grub/grub.cfg",
                "w"
            ) as f:
                f.write(grub_base)

            # -------------------------------------------------
            # P3 vira o ponto primário do GRUB.
            # Assim o menu continua disponível mesmo se
            # a root estiver danificada.
            # -------------------------------------------------

            run(
                "mkdir -p "
                "/mnt/stackos-install/stackos-recovery"
            )

            run(
                "mount --bind "
                "/mnt/stackos-recovery "
                "/mnt/stackos-install/stackos-recovery"
            )

            run(
                "chroot /mnt/stackos-install "
                "grub-install "
                "--target=x86_64-efi "
                "--efi-directory=/boot/efi "
                "--boot-directory=/stackos-recovery/boot "
                "--bootloader-id=StackOS --removable --no-nvram "
                "--recheck " +
                disk
            )

            run("sync")

        else:

            # Modos que não possuem a partição Recovery
            # continuam usando o GRUB tradicional.
            run(
                "chroot /mnt/stackos-install "
                "grub-install "
                "--target=x86_64-efi "
                "--efi-directory=/boot/efi "
                "--bootloader-id=StackOS --removable --no-nvram "
                "--recheck " +
                disk
            )

            run(
                "chroot /mnt/stackos-install "
                "grub-mkconfig "
                "-o /boot/grub/grub.cfg"
            )
        run("rm -f /mnt/stackos-install/etc/xdg/autostart/stackos-installer.desktop", check=False)
        run("rm -f /mnt/stackos-install/home/stackos/.config/autostart/stackos-installer.desktop", check=False)
        run("rm -f /mnt/stackos-install/usr/share/applications/stackos-installer.desktop", check=False)

        # Politicas permissivas existem apenas na sessao Live.
        run("rm -f /mnt/stackos-install/etc/polkit-1/rules.d/10-stackos-live.rules", check=False)
        run("rm -f /mnt/stackos-install/etc/polkit-1/rules.d/10-stackos.rules", check=False)
        run("rm -f /mnt/stackos-install/etc/sudoers.d/stackos-live", check=False)
        run("rm -f /mnt/stackos-install/etc/sudoers.d/stackos-installer", check=False)
        subprocess.run("rm -f /mnt/stackos-install/etc/apt/sources.list.d/stackos-local.list", shell=True)
        subprocess.run("rm -f /mnt/stackos-install/etc/apt/sources.list.d/ubuntu.list", shell=True)
        for relative in ['etc/polkit-1/rules.d/49-stackos-live.rules', 'etc/sudoers.d/stackos-live', 'etc/xdg/autostart/stackos-welcome.desktop']:
            Path('/mnt/stackos-install', relative).unlink(missing_ok=True)
        Path('/mnt/stackos-install/etc/machine-id').write_text('')
        release=Path('/mnt/stackos-install/etc/os-release')
        release.write_text(release.read_text().replace(' Live ', ' '))
        run('chroot /mnt/stackos-install systemctl enable stackos-snapshot.service')

        Path('/mnt/stackos-install/etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf').unlink(missing_ok=True)
        run(['chroot', '/mnt/stackos-install', 'passwd', '-l', 'root'])
        self.set_progress(0.96, self.tr("finishing"))

        # Recovery não pode estar bind-mounted durante
        # a criação da imagem de fábrica.
        run(
            "umount -lf "
            "/mnt/stackos-install/stackos-recovery",
            check=False
        )

        run(
            "rmdir "
            "/mnt/stackos-install/stackos-recovery",
            check=False
        )

        run("umount -lf /mnt/stackos-install/sys/firmware/efi/efivars", check=False)
        run("umount -lf /mnt/stackos-install/dev", check=False)
        run("umount -lf /mnt/stackos-install/proc", check=False)
        run("umount -lf /mnt/stackos-install/sys", check=False)
        run("umount -lf /mnt/stackos-install/boot/efi", check=False)


        # Cria a imagem limpa usada pelo StackOS Factory Reset.
        recovery_generator = (
            "/mnt/stackos-install/usr/lib/stackos/"
            "stackos-create-factory-image"
        )

        if not os.path.isfile(recovery_generator):
            raise RuntimeError(
                "Gerador da imagem de recuperação não encontrado"
            )

        self.set_progress(0.96, self.tr("finishing") + " — Recovery")
        run(
            recovery_generator +
            " /mnt/stackos-install"
        )

        recovery_image = (
            "/mnt/stackos-install/var/lib/stackos/recovery/"
            "factory.squashfs"
        )

        recovery_hash = (
            "/mnt/stackos-install/var/lib/stackos/recovery/"
            "factory.sha256"
        )

        if self.mode == 'erase' and self.recovery:
            recovery_partition_image = (
                "/mnt/stackos-recovery/factory/factory.squashfs"
            )
            recovery_partition_hash = (
                "/mnt/stackos-recovery/factory/factory.sha256"
            )

            run(
                "cp -a " + recovery_image +
                " " + recovery_partition_image
            )
            run(
                "cp -a " + recovery_hash +
                " " + recovery_partition_hash
            )

            if not os.path.isfile(recovery_partition_image):
                raise RuntimeError(
                    "Imagem de fábrica não foi gravada na partição Recovery"
                )

            if not os.path.isfile(recovery_partition_hash):
                raise RuntimeError(
                    "Hash da imagem de fábrica não foi gravado na partição Recovery"
                )

            run(
                "cd /mnt/stackos-recovery/factory && "
                "sha256sum -c factory.sha256"
            )

            run("sync")

            # A cópia oficial fica somente na P3.
            # Remove o arquivo temporário usado para gerar/copy.
            run(
                "rm -f " +
                recovery_image +
                " " +
                recovery_hash
            )

            run("sync")
            run("umount /mnt/stackos-recovery")

            if self.backups:
                run(
                    "umount /mnt/stackos-backups",
                    check=False
                )

        # No modo erase, a imagem oficial já foi copiada,
        # validada por SHA256 e preservada na partição Recovery (P3).
        # A cópia temporária é removida intencionalmente.
        if self.mode != 'erase':
            if not os.path.isfile(recovery_image):
                raise RuntimeError(
                    "Imagem de recuperação não foi criada"
                )

            if not os.path.isfile(recovery_hash):
                raise RuntimeError(
                    "Hash da imagem de recuperação não foi criado"
                )

        run("umount -lf /mnt/stackos-install", check=False)

        self.set_progress(1.0, self.tr("completed"))
        time.sleep(1)
        GLib.idle_add(self.show_done)

    def show_done(self):
        self.installing = False
        self.clear()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        box.set_margin_top(60)
        box.set_margin_bottom(40)
        box.set_margin_start(60)
        box.set_margin_end(60)

        title = Gtk.Label(
            label=self.tr("done_title")
        )
        title.add_css_class('title')
        title.set_margin_bottom(8)
        box.append(title)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        card.add_css_class('card')
        card.set_margin_top(20)
        card.set_margin_bottom(30)

        msg = Gtk.Label(
            label=self.tr("done_message")
        )
        msg.add_css_class('label-white')
        msg.set_justify(Gtk.Justification.CENTER)
        msg.set_wrap(True)
        card.append(msg)
        box.append(card)

        btn = Gtk.Button(
            label=self.tr("restart_now")
        )
        btn.add_css_class('btn-primary')
        btn.set_halign(Gtk.Align.CENTER)
        btn.connect('clicked', lambda b: None if self.preview else run("reboot", check=False))
        box.append(btn)

        self.present_page(box, 'done')

if __name__ == "__main__":
    app = StackOSInstaller()
    app.run([arg for arg in sys.argv if arg != "--preview"])
