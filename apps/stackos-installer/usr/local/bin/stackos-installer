        ("Español (México)",         "es_MX"),
        ("Français",                 "fr_FR"),
        ("Deutsch",                  "de_DE"),
        ("Italiano",                 "it_IT"),
        ("Nederlands",               "nl_NL"),
        ("Polski",                   "pl_PL"),
        ("Türkçe",                   "tr_TR"),
        ("Русский",                  "ru_RU"),
        ("日本語",                    "ja_JP"),
    ]

