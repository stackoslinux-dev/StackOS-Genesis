    def tr(self, key, **kwargs):
        lang = getattr(self, "ui_lang", "pt_BR")

        # Variantes que compartilham traducao.
        fallback_lang = {
            "pt_PT": "pt_BR",
            "en_GB": "en_US",
            "es_MX": "es_ES",
        }.get(lang, lang)

        table = self.TRANSLATIONS.get(lang, {})

        value = table.get(key)

        if value is None:
            value = self.TRANSLATIONS.get(
                fallback_lang,
                {}
            ).get(key)

        if value is None:
            value = self.TRANSLATIONS["en_US"].get(
                key,
                self.TRANSLATIONS["pt_BR"].get(key, key)
            )

        if kwargs:
            try:
                value = value.format(**kwargs)
            except Exception:
                pass

        return value.replace("\\n", "\n")


    def on_welcome_language_changed(self, combo, pspec):
        index = combo.get_selected()

        if index < 0 or index >= len(self.UI_LANGUAGES):
            return

        lang = self.UI_LANGUAGES[index][1]

        if lang == self.ui_lang:
            return

        self.ui_lang = lang
        self.locale = lang + '.UTF-8'
        os.environ['LANG'] = self.locale
        os.environ['LANGUAGE'] = lang + ':' + lang.split('_')[0]
        if not self.preview:
            result = subprocess.run(['/usr/lib/stackos/stackos-set-language', lang], capture_output=True, text=True)
            if result.returncode:
                Gtk.AlertDialog(message='Idioma indisponível', detail=result.stderr).show(self.win)

        # Redesenha imediatamente a primeira tela.
        self.show_welcome()


    def show_welcome(self):
        self.clear()

        box = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL,
            spacing=0
        )

        box.set_margin_top(30)
        box.set_margin_bottom(30)
        box.set_margin_start(60)
        box.set_margin_end(60)

        logo_path = Path('/usr/share/stackos-installer/stackos-symbol.png')
        if self.preview:
            logo_path = Path(__file__).resolve().parents[2] / 'share/stackos-installer/stackos-symbol.png'
        emblem = Gtk.Image.new_from_file(str(logo_path))
        emblem.set_pixel_size(88)
        emblem.set_margin_bottom(12)
        box.append(emblem)
        logo = Gtk.Label(label="StackOS Genesis")
        logo.add_css_class('title')
        logo.set_margin_bottom(6)
        box.append(logo)

        gen = Gtk.Label(label="Instalador oficial" if self.ui_lang.startswith("pt") else "Official installer")
        gen.add_css_class('label-blue')
        gen.set_margin_bottom(24)
        box.append(gen)

        # Idioma da interface.
        lang_box = Gtk.Box(
            orientation=Gtk.Orientation.HORIZONTAL,
            spacing=12
        )
        lang_box.set_halign(Gtk.Align.CENTER)
        self.responsive_boxes.append((lang_box, 650))
        lang_box.set_margin_bottom(18)

        lang_label = Gtk.Label(
            label=self.tr("language")
        )
        lang_label.add_css_class('label-blue')
        lang_label.add_css_class('no-wrap')

        self.welcome_language_combo = (
            Gtk.DropDown.new_from_strings(
                [x[0] for x in self.UI_LANGUAGES]
            )
        )

        current_index = 0

        for i, (_, code) in enumerate(self.UI_LANGUAGES):
            if code == self.ui_lang:
                current_index = i
                break

        self.welcome_language_combo.set_selected(
            current_index
        )

        self.welcome_language_combo.set_size_request(
            280,
            -1
        )

        lang_box.append(lang_label)
        lang_box.append(self.welcome_language_combo)

        box.append(lang_box)

        card = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL,
            spacing=12
        )

        card.add_css_class('card')
        card.set_margin_bottom(30)

        msg = Gtk.Label(
            label=(
                self.tr("welcome") +
                "\n\n" +
                self.tr("welcome_body") +
                "\n\n" +
                self.tr("slogan")
            )
        )

        msg.add_css_class('label-white')
        msg.set_justify(Gtk.Justification.CENTER)
        msg.set_wrap(True)

        card.append(msg)
        box.append(card)

        nav, btn = self.make_nav(
            next_label=self.tr("start"),
            next_cb=lambda b: self.show_disk()
        )

        box.append(nav)

        self.present_page(box, 'welcome')

        self.welcome_language_combo.connect(
            "notify::selected",
            self.on_welcome_language_changed
        )


    def show_disk(self):
        self.clear()
        r = subprocess.CompletedProcess([], 0, 'demo disk 128G 0\n') if self.preview else subprocess.run(['lsblk','-rno','NAME,TYPE,SIZE,RM'], capture_output=True, text=True)
        disks = []
        for line in r.stdout.splitlines():
            p = line.split()
            if len(p) >= 4 and p[1] == 'disk' and p[3] == '0':
                disks.append((p[0], p[2]))

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        box.set_margin_top(18)
        box.set_margin_bottom(18)
        box.set_margin_start(24)
        box.set_margin_end(24)
        box.append(
            self.make_header(
                self.tr("select_disk")
            )
        )

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        card.add_css_class('card')
        card.set_margin_bottom(20)

        self.disk_radios = []
        group = None
        for name, size in disks:
            rb = Gtk.CheckButton(label=f"/dev/{name}  \u2014  {size}")
            rb.add_css_class('radio')
            if group is None:
                group = rb
            else:
                rb.set_group(group)
            rb.disk = f"/dev/{name}"
            self.disk_radios.append(rb)
            card.append(rb)

        if self.disk_radios:
            self.disk_radios[0].set_active(True)

        box.append(card)
        nav, btn = self.make_nav(
            back_cb=lambda b: self.show_welcome(),
            next_label=self.tr("next"),
            next_cb=lambda b: self.on_disk_next()
        )
        btn.set_sensitive(bool(self.disk_radios))
        if not self.disk_radios:
            card.append(Gtk.Label(label="Nenhum disco disponível. Conecte um disco e tente novamente.", wrap=True))
        box.append(nav)
        self.present_page(box, 'disk')

    def on_disk_next(self):
        for rb in self.disk_radios:
            if rb.get_active():
                self.disk = rb.disk
                break
        if not self.disk:
            return
        self.show_mode()

    def show_mode(self):
        self.clear()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        box.set_margin_top(30)
        box.set_margin_bottom(30)
        box.set_margin_start(60)
        box.set_margin_end(60)
        box.append(
            self.make_header(
                self.tr(
                    "install_how",
                    disk=self.disk
                )
            )
        )

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        card.add_css_class('card')
        card.set_margin_bottom(20)

        self.rb_erase = Gtk.CheckButton(
            label=self.tr("erase")
        )
        self.rb_erase.add_css_class('radio')
        self.rb_erase.set_active(True)
        card.append(self.rb_erase)

        desc_erase = Gtk.Label(
            label="  " + self.tr("erase_desc")
        )
        desc_erase.add_css_class('label-blue')
        desc_erase.set_halign(Gtk.Align.START)
        card.append(desc_erase)

        self.rb_dual = Gtk.CheckButton(
            label=self.tr("dual")
        )
        self.rb_dual.add_css_class('radio')
        self.rb_dual.set_group(self.rb_erase)
        pass  # dual boot button removed (NODUALBOOT-20260916)

        desc_dual = Gtk.Label(
            label="  " + self.tr("dual_desc")
        )
        desc_dual.add_css_class('label-blue')
        desc_dual.set_halign(Gtk.Align.START)
        desc_dual.set_visible(False)
        card.append(desc_dual)

        self.rb_manual = Gtk.CheckButton(
            label=self.tr("manual")
        )
        self.rb_manual.add_css_class('radio')
        self.rb_manual.set_group(self.rb_erase)
        card.append(self.rb_manual)

        desc_manual = Gtk.Label(
            label="  " + self.tr("manual_desc")
        )
        desc_manual.add_css_class('label-blue')
        desc_manual.set_halign(Gtk.Align.START)
        card.append(desc_manual)

        box.append(card)
        nav, btn = self.make_nav(
            back_cb=lambda b: self.show_disk(),
            next_label=self.tr("next"),
            next_cb=lambda b: self.on_mode_next()
        )
        box.append(nav)
        self.present_page(box, 'mode')

    def on_mode_next(self):
        if self.rb_erase.get_active():
            self.mode = 'erase'
            self.show_confirm_erase()
        elif False:  # dual boot branch disabled (NODUALBOOT-20260916)
            self.mode = 'dual'
            self.show_dual_size()
        else:
            self.mode = 'manual'
            if not self.preview:
                subprocess.Popen(['gparted', self.disk] if shutil.which('gparted') else ['gnome-disks', '--block-device', self.disk])

    def show_confirm_erase(self):
        self.clear()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        box.set_margin_top(30)
        box.set_margin_bottom(30)
        box.set_margin_start(60)
        box.set_margin_end(60)
        box.append(
            self.make_header(
                self.tr("confirmation")
            )
        )

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        card.add_css_class('card')
        card.set_margin_bottom(20)

        warn = Gtk.Label(
            label=(
                self.tr("warning") +
                "\n\n" +
                self.tr(
                    "erase_warning",
                    disk=self.disk
                )
            )
        )
        warn.add_css_class('label-white')
        warn.set_justify(Gtk.Justification.CENTER)
        warn.set_wrap(True)
        card.append(warn)
        box.append(card)

        nav, btn = self.make_nav(
            back_cb=lambda b: self.show_mode(),
            next_label=self.tr("confirm_continue"),
            next_cb=lambda b: self.show_locale(),
            next_style='btn-danger'
        )
        box.append(nav)
        self.present_page(box, 'confirm_erase')

    def show_dual_size(self):
        self.clear()
        parted_out = subprocess.run(['parted','-s',self.disk,'unit','MiB','print','free'], capture_output=True, text=True)
        free_spaces = []
        for line in parted_out.stdout.splitlines():
            if 'Free Space' in line:
                m = re.findall(r'([\d]+(?:[.,]\d+)?)MiB', line)
                if len(m) >= 3:
                    s = float(m[0].replace(',','.'))
                    e = float(m[1].replace(',','.'))
                    size = float(m[2].replace(',','.'))
                    if size > 5000:
                        free_spaces.append((s, e, size))

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        box.set_margin_top(30)
        box.set_margin_bottom(30)
        box.set_margin_start(60)
        box.set_margin_end(60)
        box.append(
            self.make_header(
                self.tr("dual_title")
            )
        )

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        card.add_css_class('card')
        card.set_margin_bottom(20)

        if not free_spaces:
            msg = Gtk.Label(
                label=self.tr("no_free_space")
            )
            msg.add_css_class('label-white')
            card.append(msg)
            box.append(card)
            nav, _ = self.make_nav(back_cb=lambda b: self.show_mode())
            box.append(nav)
            self.present_page(box, 'dual_size')
            return

        self.dual_start, self.dual_end, free_size = max(free_spaces, key=lambda x: x[2])
        suggest = int(free_size * 0.8)

        msg = Gtk.Label(
            label=self.tr(
                "free_space",
                size=int(free_size)
            )
        )
        msg.add_css_class('label-white')
        msg.set_justify(Gtk.Justification.CENTER)
        card.append(msg)

        lbl = Gtk.Label(
            label=self.tr("stackos_size")
        )
        lbl.add_css_class('label-blue')
        lbl.set_halign(Gtk.Align.START)
        lbl.set_margin_top(10)
        card.append(lbl)

        self.size_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 10000, int(free_size), 1024)
        self.size_scale.set_value(suggest)
        self.size_scale.set_draw_value(True)
        self.size_scale.set_hexpand(True)
        card.append(self.size_scale)

        box.append(card)
        nav, btn = self.make_nav(
            back_cb=lambda b: self.show_mode(),
            next_label=self.tr("next"),
            next_cb=lambda b: self.on_dual_next()
        )
        box.append(nav)
        self.present_page(box, 'dual_size')

    def on_dual_next(self):
        self.dual_size = int(self.size_scale.get_value())
        self.show_locale()

    def show_user(self):
        self.clear()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        box.set_margin_top(30)
        box.set_margin_bottom(30)
        box.set_margin_start(60)
        box.set_margin_end(60)
        box.append(
            self.make_header(
                self.tr("configure_user")
            )
        )

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        card.add_css_class('card')
        card.set_margin_bottom(20)

        # --- aviso do disco (muda conforme o modo escolhido) ---
        if self.mode == 'erase':
            aviso = Gtk.Label(label=self.tr("erase_disk_short_warning").format(disk=self.disk))
            aviso.add_css_class('warn-erase')
        else:
            aviso = Gtk.Label(label=f"\u2713  O StackOS sera instalado ao lado do sistema atual, sem apagar seus dados.")
            aviso.add_css_class('warn-dual')
        aviso.set_wrap(True)
        aviso.set_justify(Gtk.Justification.CENTER)
        aviso.set_margin_bottom(6)
        card.append(aviso)

        lbl_user = Gtk.Label(
            label=self.tr("username")
        )
        lbl_user.add_css_class('label-blue')
        lbl_user.set_halign(Gtk.Align.START)
        card.append(lbl_user)

        self.entry_user = Gtk.Entry()
        self.entry_user.add_css_class('entry')
        self.entry_user.set_placeholder_text(self.tr("username_placeholder"))
        if self.username:
            self.entry_user.set_text(self.username)
        card.append(self.entry_user)

        lbl_pass = Gtk.Label(
            label=self.tr("password")
        )
        lbl_pass.add_css_class('label-blue')
        lbl_pass.set_halign(Gtk.Align.START)
        lbl_pass.set_margin_top(8)
        card.append(lbl_pass)

        self.entry_pass = Gtk.Entry()
        self.entry_pass.add_css_class('entry')
        self.entry_pass.set_visibility(False)
        self.entry_pass.set_placeholder_text(self.tr("password_placeholder"))
        card.append(self.entry_pass)

        lbl_conf = Gtk.Label(
            label=self.tr("confirm_password")
        )
        lbl_conf.add_css_class('label-blue')
        lbl_conf.set_halign(Gtk.Align.START)
        lbl_conf.set_margin_top(4)
        card.append(lbl_conf)

        self.entry_conf = Gtk.Entry()
        self.entry_conf.add_css_class('entry')
        self.entry_conf.set_visibility(False)
        self.entry_conf.set_placeholder_text(self.tr("confirm_password_placeholder"))
        card.append(self.entry_conf)

        # --- campo editavel: nome do computador (vem sugerido como usuario-marca-modelo) ---
        if not hasattr(self, '_hw_tag'):
            self._hw_tag = hardware_tag()

        lbl_host = Gtk.Label(
            label=self.tr("hostname")
        )
        lbl_host.add_css_class('label-blue')
        lbl_host.set_halign(Gtk.Align.START)
        lbl_host.set_margin_top(8)
        card.append(lbl_host)

        self.entry_host = Gtk.Entry()
        self.entry_host.add_css_class('entry')
        self.entry_host.set_placeholder_text(self.tr("hostname_placeholder"))
        if self.hostname:
            self.entry_host.set_text(self.hostname)
        card.append(self.entry_host)

        # enquanto o usuario nao editar o nome do PC manualmente,
        # ele segue o nome de usuario automaticamente (usuario-marca-modelo)
        self._host_auto = not bool(self.hostname)

        def on_user_changed(entry):
            if not self._host_auto:
                return
            u = _slug(entry.get_text())
            suggestion = f"{u}-{self._hw_tag}" if u else ""
            self._host_setting_auto = True
            self.entry_host.set_text(suggestion)
            self._host_setting_auto = False

        def on_host_changed(entry):
            if not getattr(self, '_host_setting_auto', False):
                self._host_auto = False

        self.entry_user.connect('changed', on_user_changed)
        self.entry_host.connect('changed', on_host_changed)

        self.lbl_error = Gtk.Label(label="")
        self.lbl_error.add_css_class('label-blue')
        card.append(self.lbl_error)

        box.append(card)
        back_cb = lambda b: self.show_confirm_erase() if self.mode == 'erase' else self.show_dual_size()
        nav, btn = self.make_nav(
            back_cb=back_cb,
            next_label=self.tr("next"),
            next_cb=lambda b: self.on_user_next()
        )
        box.append(nav)
        self.present_page(box, 'user')

    def on_user_next(self):
        user = self.entry_user.get_text().strip()
        passwd = self.entry_pass.get_text()
        conf = self.entry_conf.get_text()
        host = self.entry_host.get_text().strip()

        if not user:
            self.lbl_error.set_text(self.tr("username_required"))
            return
        if ' ' in user:
            self.lbl_error.set_text(self.tr("username_spaces"))
            return
        if passwd != conf:
            self.lbl_error.set_text(self.tr("password_mismatch"))
            return
        if not host:
            self.lbl_error.set_text(self.tr("hostname_required"))
            return

        self.username = user
        self.password = passwd
        self.hostname = _slug(host) or host
        self.show_locale()

