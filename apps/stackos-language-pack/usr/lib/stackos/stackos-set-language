# Future applications in the active session inherit the selection too.
subprocess.run(['systemctl','set-environment','LANG='+lang,'LANGUAGE='+code+':'+code.split('_')[0]],capture_output=True)
user=os.environ.get('SUDO_USER','stackos')
try:
 import pwd
 info=pwd.getpwnam(user)
 if info.pw_uid:
  env=['XDG_RUNTIME_DIR=/run/user/'+str(info.pw_uid),'DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/'+str(info.pw_uid)+'/bus']
  subprocess.run(['sudo','-H','-u',user,'env']+env+['systemctl','--user','set-environment','LANG='+lang,'LANGUAGE='+code+':'+code.split('_')[0]],capture_output=True)
  subprocess.run(['sudo','-H','-u',user,'env']+env+['gsettings','set','org.gnome.system.locale','region',lang],capture_output=True)
except KeyError:pass
print('SYSTEM_LANGUAGE_APPLIED',code)
