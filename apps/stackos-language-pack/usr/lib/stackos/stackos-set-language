#!/usr/bin/env python3
import os,sys,subprocess,json
from pathlib import Path
SUPPORTED=['pt_BR','pt_PT','en_US','en_GB','es_ES','es_MX','fr_FR','de_DE','it_IT','nl_NL','pl_PL','tr_TR','ru_RU','ja_JP']
if os.geteuid()!=0:raise SystemExit('É necessário executar como administrador.')
code=sys.argv[1] if len(sys.argv)==2 else ''
if code not in SUPPORTED:raise SystemExit('Idioma não suportado: '+code)
lang=code+'.UTF-8';text='LANG='+lang+'\nLANGUAGE='+code+':'+code.split('_')[0]+'\n'
for name in ['/etc/locale.conf','/etc/default/locale']:
