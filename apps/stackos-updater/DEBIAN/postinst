#!/bin/sh
set -e
if [ "$1" = configure ]; then
 command -v update-desktop-database >/dev/null && update-desktop-database /usr/share/applications || true
 command -v gtk-update-icon-cache >/dev/null && gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
 command -v dconf >/dev/null && dconf update || true
 systemctl --global enable stackos-updater.service stackos-updater-indicator.service >/dev/null 2>&1 || true
 for runtime in /run/user/[0-9]*; do
  [ -S "$runtime/bus" ] || continue
  uid=$(basename "$runtime")
  [ "$uid" -gt 0 ] || continue
  name=$(getent passwd "$uid" | cut -d: -f1)
  [ -n "$name" ] || continue
  runuser -u "$name" -- env XDG_RUNTIME_DIR="$runtime" DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" systemctl --user daemon-reload >/dev/null 2>&1 || true
  runuser -u "$name" -- env XDG_RUNTIME_DIR="$runtime" DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" systemctl --user start stackos-updater.service stackos-updater-indicator.service >/dev/null 2>&1 || true
  runuser -u "$name" -- env XDG_RUNTIME_DIR="$runtime" DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" gdbus call --session --dest org.gnome.Shell.Extensions --object-path /org/gnome/Shell/Extensions --method org.gnome.Shell.Extensions.EnableExtension stackos-updater@stackoslinux >/dev/null 2>&1 || true
 done
fi
exit 0
